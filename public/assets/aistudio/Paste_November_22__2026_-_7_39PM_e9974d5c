  <script>
    (function () {
      // ---------- DOM 元素引用 ----------
      const form = document.getElementById('reset-form');
      const phoneInput = document.getElementById('phone-input');
      const clearPhoneBtn = document.getElementById('clear-phone-btn');
      const codeInput = document.getElementById('code-input');
      const newPasswordInput = document.getElementById('new-password-input');
      const phoneError = document.getElementById('phone-error');
      const codeError = document.getElementById('code-error');
      const passwordError = document.getElementById('password-error');
      const sendCodeBtn = document.getElementById('send-code-btn');
      const sendCodeLabel = document.getElementById('send-code-label');
      const togglePwdBtn = document.getElementById('toggle-pwd-btn');
      const togglePwdIcon = document.getElementById('toggle-pwd-icon');
      const submitBtn = document.getElementById('submit-btn');
      const submitSpinner = document.getElementById('submit-spinner');
      const submitLabel = document.getElementById('submit-label');
      const modalSms = document.getElementById('modal-sms');
      const modalSuccess = document.getElementById('modal-success');

      let countdownTimer = null; // 验证码 60s 倒计时句柄

      // ---------- 输入过滤、清空与新密码明/密文切换 ----------
      phoneInput.addEventListener('input', function () {
        phoneInput.value = phoneInput.value.replace(/\D/g, '');
        clearPhoneBtn.classList.toggle('hidden', phoneInput.value.length === 0);
        phoneError.classList.add('hidden');
      });

      clearPhoneBtn.addEventListener('click', function () {
        phoneInput.value = '';
        clearPhoneBtn.classList.add('hidden');
        phoneInput.focus();
      });

      codeInput.addEventListener('input', function () {
        codeInput.value = codeInput.value.replace(/\D/g, '');
        codeError.classList.add('hidden');
      });

      newPasswordInput.addEventListener('input', function () {
        passwordError.classList.add('hidden');
      });

      togglePwdBtn.addEventListener('click', function () {
        const isPwd = newPasswordInput.type === 'password';
        newPasswordInput.type = isPwd ? 'text' : 'password';
        togglePwdIcon.textContent = isPwd ? 'visibility' : 'visibility_off';
      });

      // ---------- 表单校验函数 ----------
      function validatePhone() {
        const valid = /^1\d{10}$/.test(phoneInput.value.trim());
        phoneError.classList.toggle('hidden', valid);
        return valid;
      }

      function validateCode() {
        const valid = /^\d{4,6}$/.test(codeInput.value.trim());
        codeError.classList.toggle('hidden', valid);
        return valid;
      }

      function validatePassword() {
        const len = newPasswordInput.value.length;
        const valid = len >= 6 && len <= 20;
        passwordError.classList.toggle('hidden', valid);
        return valid;
      }

      // ---------- 获取验证码：校验手机号并启动 60s 倒计时 ----------
      sendCodeBtn.addEventListener('click', function () {
        if (!validatePhone()) {
          phoneInput.focus();
          return;
        }
        let seconds = 60;
        sendCodeBtn.disabled = true;
        sendCodeLabel.textContent = seconds + 's 后重发';
        modalSms.showModal();
        codeInput.focus();
        clearInterval(countdownTimer);
        countdownTimer = setInterval(function () {
          seconds -= 1;
          if (seconds <= 0) {
            clearInterval(countdownTimer);
            sendCodeBtn.disabled = false;
            sendCodeLabel.textContent = '获取验证码';
          } else {
            sendCodeLabel.textContent = seconds + 's 后重发';
          }
        }, 1000);
      });

      // ---------- 提交重置表单：全量校验通过后展示提交态并弹出成功弹窗 ----------
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const pOk = validatePhone();
        const cOk = validateCode();
        const pwdOk = validatePassword();
        if (!pOk || !cOk || !pwdOk) return;
        submitBtn.disabled = true;
        submitSpinner.classList.remove('hidden');
        submitLabel.textContent = '正在提交...';
        setTimeout(function () {
          submitBtn.disabled = false;
          submitSpinner.classList.add('hidden');
          submitLabel.textContent = '确认重置密码';
          modalSuccess.showModal();
        }, 420);
      });

      document.getElementById('modal-sms-close').addEventListener('click', function () {
        modalSms.close();
      });
    })();
  </script>


</body></html>

