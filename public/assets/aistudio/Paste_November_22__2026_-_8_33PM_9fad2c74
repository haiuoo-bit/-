      if (modelsEl) modelsEl.textContent = station.models;
      if (urlEl) urlEl.textContent = station.url;

      // ---------- 2. 轻提示与复制接口地址 ----------
      const url = station.url;
      const toast = document.getElementById('detail-toast');
      let toastTimer = null;

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 1800);
      }

      function copyUrl() {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).catch(function () {});
        }
        showToast('已复制接口地址：' + url);
      }

      document.getElementById('copy-url-btn').addEventListener('click', copyUrl);
      document.getElementById('header-copy-btn').addEventListener('click', copyUrl);

      // ---------- 3. 星级评分、印象标签、体验补充与本地持久化 ----------
      const starBtns = Array.from(document.querySelectorAll('.star-btn'));
      const ratingLabel = document.getElementById('selected-rating-label');
      const starNumeric = document.getElementById('star-numeric');
      const feedbackNoteInput = document.getElementById('feedback-note-input');
      const ratedBanner = document.getElementById('rated-banner');
      const ratedBannerText = document.getElementById('rated-banner-text');
      const submitRatingBtn = document.getElementById('submit-rating-btn');
      const labels = ['', '1 星 · 较差', '2 星 · 一般', '3 星 · 可用', '4 星 · 推荐', '5 星 · 非常稳定'];
      let chosenStar = 0;
      let hasSubmitted = false;

      function paintStars(val, animate) {
        chosenStar = val;
        starBtns.forEach(function (b) {
          const s = Number(b.getAttribute('data-star'));
          const active = s <= chosenStar;
          b.classList.toggle('text-success', active);
          b.classList.toggle('text-light-outline-variant', !active);
          b.setAttribute('aria-checked', s === chosenStar ? 'true' : 'false');
          if (animate && s === chosenStar) {
            b.classList.add('scale-110');
            setTimeout(function () { b.classList.remove('scale-110'); }, 160);
          }
        });
        if (ratingLabel) {
          ratingLabel.textContent = labels[chosenStar] || '点击星星评分';
          ratingLabel.classList.toggle('text-success', chosenStar > 0);
          ratingLabel.classList.toggle('text-light-on-surface-variant', chosenStar === 0);
        }
        if (starNumeric) {
          starNumeric.textContent = chosenStar ? (chosenStar + '.0') : '--';
          starNumeric.classList.toggle('text-success', chosenStar > 0);
          starNumeric.classList.toggle('text-light-on-surface-variant', chosenStar === 0);
        }
        if (submitRatingBtn) {
          submitRatingBtn.disabled = chosenStar === 0;
          submitRatingBtn.classList.remove('bg-success');
          submitRatingBtn.classList.toggle('bg-light-primary', chosenStar > 0);
          submitRatingBtn.classList.toggle('text-light-on-primary', chosenStar > 0);
          submitRatingBtn.classList.toggle('bg-light-surface-container', chosenStar === 0);
          submitRatingBtn.classList.toggle('text-light-on-surface-variant', chosenStar === 0);
          submitRatingBtn.textContent = chosenStar
            ? (hasSubmitted ? ('更新 ' + chosenStar + ' 星反馈') : ('提交 ' + chosenStar + ' 星反馈'))
            : '请先选择星级';
        }
      }

      starBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          paintStars(Number(btn.getAttribute('data-star')), true);
        });
      });

      // 切换印象标签选中状态
      document.querySelectorAll('.rate-tag').forEach(function (tag) {
        tag.addEventListener('click', function () {
          const active = tag.classList.toggle('bg-light-primary');
          tag.classList.toggle('text-light-on-primary', active);
          tag.classList.toggle('bg-light-surface-container', !active);
          tag.classList.toggle('text-light-on-surface-variant', !active);
        });
      });

      // 回显本地已保存的历史评分与反馈
      try {
        const raw = localStorage.getItem('island_relay_ratings');
        if (raw) {
          const saved = JSON.parse(raw);
          const entry = saved[stationId];
          if (entry && entry.myStar) {
            hasSubmitted = true;
            paintStars(entry.myStar, false);
            if (avgEl && entry.avg) avgEl.textContent = entry.avg;
            if (countEl && entry.count) countEl.textContent = entry.count + ' 人评分';
            if (feedbackNoteInput && entry.note) feedbackNoteInput.value = entry.note;
            if (Array.isArray(entry.tags)) {
              document.querySelectorAll('.rate-tag').forEach(function (t) {
                if (entry.tags.indexOf(t.textContent.trim()) !== -1) {
                  t.classList.add('bg-light-primary', 'text-light-on-primary');
                  t.classList.remove('bg-light-surface-container', 'text-light-on-surface-variant');
                }
              });
            }
            if (ratedBanner && ratedBannerText) {
              ratedBannerText.textContent = '你已评 ' + entry.myStar + ' 星，点击上方星级可随时修改';
              ratedBanner.classList.remove('hidden');
            }
            if (submitRatingBtn) {
              submitRatingBtn.classList.remove('bg-light-primary');
              submitRatingBtn.classList.add('bg-success');
              submitRatingBtn.textContent = '已提交反馈 · 点星级可修改';
            }
          }
        }
      } catch (e) {}

      // 提交反馈与评分并更新综合均分
      submitRatingBtn.addEventListener('click', function () {
        if (!chosenStar) {
          showToast('请先点击星星选择评分');
          return;
        }
        const activeTags = Array.from(document.querySelectorAll('.rate-tag.bg-light-primary')).map(function (t) { return t.textContent.trim(); });
        const note = feedbackNoteInput ? feedbackNoteInput.value.trim() : '';
        const newCount = station.count + 1;
        const newAvg = (((station.score * station.count) + chosenStar) / newCount).toFixed(1);

        if (avgEl) avgEl.textContent = newAvg;
        if (countEl) countEl.textContent = newCount + ' 人评分';
        if (ratedBanner && ratedBannerText) {
          ratedBannerText.textContent = '已提交 ' + chosenStar + ' 星反馈' + (activeTags.length ? '（' + activeTags.join('、') + '）' : '') + '，最新均分 ' + newAvg;
          ratedBanner.classList.remove('hidden');
        }
        submitRatingBtn.classList.remove('bg-light-primary');
        submitRatingBtn.classList.add('bg-success');
        submitRatingBtn.textContent = '已提交反馈 · 点星级可修改';

        try {
          const raw = localStorage.getItem('island_relay_ratings');
          const saved = raw ? JSON.parse(raw) : {};
          saved[stationId] = {
            avg: newAvg,
            count: newCount,
            myStar: chosenStar,
            tags: activeTags,
            note: note
          };
          localStorage.setItem('island_relay_ratings', JSON.stringify(saved));
        } catch (e) {}

        showToast(hasSubmitted ? ('已更新你的反馈：' + chosenStar + ' 星') : ('感谢反馈！' + station.name + ' 综合评分已更新'));
        hasSubmitted = true;
      });
    })();
  </script>


