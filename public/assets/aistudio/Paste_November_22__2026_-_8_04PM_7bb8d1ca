  <!-- ==================== 7. 页面交互脚本（顶栏吸顶、评论同步、分享、字数统计、正文搜索） ==================== -->
  <script>
    (function () {
      const scroller = document.getElementById('article-scroller');
      const header = document.getElementById('detail-header');
      const headerFollowBtn = document.getElementById('header-follow-btn');
      const headerFollowText = document.getElementById('header-follow-text');
      const commentsSection = document.getElementById('comments-section');
      const jumpCommentsBtn = document.getElementById('jump-comments-btn');
      const quickSayBtn = document.getElementById('quick-say-btn');
      const commentInput = document.getElementById('comment-input');
      const commentForm = document.getElementById('inline-comment-form');
      const commentList = document.getElementById('comment-list');
      const totalCommentsLabel = document.getElementById('total-comments-label');
      const detailCommentCount = document.getElementById('detail-comment-count');

      const detailToast = document.getElementById('detail-toast');
      let toastTimer = null;
      let followed = true;

      // 全局轻提示 Toast
      function showDetailToast(msg) {
        if (!detailToast) return;
        detailToast.textContent = msg;
        detailToast.classList.remove('hidden');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          detailToast.classList.add('hidden');
        }, 1600);
      }

      // 根据关注状态与滚动位置同步顶栏关注胶囊样式
      function syncFollowPill() {
        const scrolledPastHero = scroller.scrollTop > 180;
        headerFollowText.textContent = followed ? '已关注' : '+ 关注';
        headerFollowBtn.classList.remove(
          'bg-dark-on-surface/15', 'border-dark-on-surface/25', 'text-dark-on-surface',
          'bg-light-surface-container', 'border-light-outline-variant', 'text-light-on-surface-variant',
          'bg-error', 'border-transparent', 'text-light-on-primary'
        );
        if (!followed) {
          headerFollowBtn.classList.add('bg-error', 'border-transparent', 'text-light-on-primary');
        } else if (scrolledPastHero) {
          headerFollowBtn.classList.add('bg-light-surface-container', 'border-light-outline-variant', 'text-light-on-surface-variant');
        } else {
          headerFollowBtn.classList.add('bg-dark-on-surface/15', 'border-dark-on-surface/25', 'text-dark-on-surface');
        }
      }

      // ---------- 1. 滚动时顶栏由透明深色渐变切换为浅色实底 ----------
      scroller.addEventListener('scroll', function () {
        const scrolledPastHero = scroller.scrollTop > 180;
        if (scrolledPastHero) {
          header.classList.remove('bg-gradient-to-b', 'from-dark-surface/75', 'via-dark-surface/35', 'to-transparent', 'text-dark-on-surface');
          header.classList.add('bg-light-surface', 'border-b', 'border-light-outline-variant', 'text-light-on-surface');
        } else {
          header.classList.add('bg-gradient-to-b', 'from-dark-surface/75', 'via-dark-surface/35', 'to-transparent', 'text-dark-on-surface');
          header.classList.remove('bg-light-surface', 'border-b', 'border-light-outline-variant', 'text-light-on-surface');
        }
        syncFollowPill();
      });

      // ---------- 2. 顶栏作者关注 / 取消关注切换 ----------
      headerFollowBtn.addEventListener('click', function () {
        followed = !followed;
        syncFollowPill();
        showDetailToast(followed ? '已关注 零度叙事' : '已取消关注');
      });

      // ---------- 3. 底部栏快捷跳转评论区 / 聚焦输入框 ----------
      jumpCommentsBtn.addEventListener('click', function () {
        commentsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      quickSayBtn.addEventListener('click', function () {
        commentsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(function () { commentInput.focus(); }, 280);
      });

      // ---------- 4. 实时发布评论与回复（通过 localStorage 与 06/20 评论抽屉双向同步） ----------
      let commentTotal = 586;
      const COMMENT_STORAGE_KEY = 'renshedao_jinghua_comments';
      let savedComments = [];
      let replyTarget = null;
      const defaultPlaceholder = commentInput.getAttribute('placeholder') || '说点什么...';

      function resetReplyTarget() {
        replyTarget = null;
        commentInput.placeholder = defaultPlaceholder;
      }

      const detailHeartSvg = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12.62 20.55C12.28 20.67 11.72 20.67 11.38 20.55C8.48 19.56 2 15.43 2 8.43C2 5.34 4.49 2.84 7.56 2.84C9.38 2.84 10.99 3.72 12 5.08C13.01 3.72 14.63 2.84 16.44 2.84C19.51 2.84 22 5.34 22 8.43C22 15.43 15.52 19.56 12.62 20.55Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

      function prependDetailComment(text) {
        const li = document.createElement('li');
        li.className = 'comment-item flex items-start gap-gutter-md';
        li.setAttribute('data-reply-author', '我');
        li.innerHTML =
          '<a href="../45-user-profile/UserProfile.html" aria-label="查看我的主页" class="w-8 h-8 rounded-full bg-light-surface-container-high flex items-center justify-center shrink-0 font-label text-label-sm text-light-on-surface hover:opacity-85 transition-opacity">我</a>' +
          '<div class="flex-1 min-w-0 flex flex-col gap-gutter-xs">' +
            '<a href="../45-user-profile/UserProfile.html" data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant hover:text-light-on-surface transition-colors self-start">我</a>' +
            '<p data-design-text-token="body-md" class="comment-body cursor-pointer font-body text-body-md text-light-on-surface text-pretty"></p>' +
            '<div class="flex items-center justify-between pt-gutter-xs">' +
              '<div class="flex items-center gap-gutter-md font-body text-body-sm text-light-on-surface-variant tabular-nums">' +
                '<span data-design-text-token="body-sm">刚刚</span>' +
                '<button type="button" data-reply-author="我" class="comment-reply-btn text-light-on-surface-variant hover:text-light-on-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">回复</button>' +
              '</div>' +
              '<button type="button" class="comment-like-btn flex items-center gap-gutter-xs text-light-on-surface-variant hover:text-error transition-colors duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">' +
                detailHeartSvg + '<span data-design-text-token="label-sm" class="comment-like-count font-label text-label-sm tabular-nums">0</span>' +
              '</button>' +
            '</div>' +
          '</div>';
        li.querySelector('p').textContent = text;
        commentList.prepend(li);
      }

      function appendDetailSubReply(parentLi, replyToAuthor, text) {
        const bodyCol = parentLi.querySelector('.flex-1');
        let subBox = parentLi.querySelector('.sub-replies-box');
        if (!subBox && bodyCol) {
          subBox = document.createElement('div');
          subBox.className = 'sub-replies-box mt-gutter-sm flex flex-col gap-gutter-md';
          bodyCol.appendChild(subBox);
        }
        if (!subBox) return;
        const sub = document.createElement('div');
        sub.className = 'sub-comment-item flex items-start gap-gutter-sm';
        sub.setAttribute('data-reply-author', '我');
        sub.innerHTML =
          '<a href="../45-user-profile/UserProfile.html" aria-label="查看我的主页" class="w-6 h-6 rounded-full bg-light-surface-container-high flex items-center justify-center shrink-0 font-label text-label-sm text-light-on-surface hover:opacity-85 transition-opacity">我</a>' +
          '<div class="flex-1 min-w-0 flex flex-col gap-gutter-xs">' +
            '<div class="flex items-center gap-gutter-xs font-label text-label-sm text-light-on-surface-variant">' +
              '<a href="../45-user-profile/UserProfile.html" class="hover:text-light-on-surface transition-colors">我</a><span aria-hidden="true">▸</span><span class="reply-to-name"></span>' +
            '</div>' +
            '<p data-design-text-token="body-md" class="comment-body cursor-pointer font-body text-body-md text-light-on-surface text-pretty"></p>' +
            '<div class="flex items-center justify-between pt-gutter-xs">' +
              '<div class="flex items-center gap-gutter-md font-body text-body-sm text-light-on-surface-variant tabular-nums">' +
                '<span data-design-text-token="body-sm">刚刚</span>' +
                '<button type="button" data-reply-author="我" class="comment-reply-btn text-light-on-surface-variant hover:text-light-on-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">回复</button>' +
              '</div>' +
              '<button type="button" class="comment-like-btn flex items-center gap-gutter-xs text-light-on-surface-variant hover:text-error transition-colors duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">' +
                detailHeartSvg + '<span data-design-text-token="label-sm" class="comment-like-count font-label text-label-sm tabular-nums">0</span>' +
              '</button>' +
            '</div>' +
          '</div>';
        sub.querySelector('.reply-to-name').textContent = replyToAuthor;
        sub.querySelector('p').textContent = text;
        subBox.appendChild(sub);
      }

      // 初始化回显本地已提交的评论
      try {
        savedComments = JSON.parse(localStorage.getItem(COMMENT_STORAGE_KEY) || '[]');
        if (Array.isArray(savedComments) && savedComments.length) {
          savedComments.forEach(function (txt) { prependDetailComment(txt); });
          commentTotal += savedComments.length;
          totalCommentsLabel.textContent = String(commentTotal);
          detailCommentCount.textContent = String(commentTotal);
        }
      } catch (e) {}

      commentForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const text = commentInput.value.trim();
        if (!text) return;
        commentTotal += 1;
        totalCommentsLabel.textContent = String(commentTotal);
        detailCommentCount.textContent = String(commentTotal);
        if (replyTarget && replyTarget.li) {
          appendDetailSubReply(replyTarget.li, replyTarget.author, text);
          resetReplyTarget();
        } else {
          prependDetailComment(text);
          savedComments.push(text);
          try { localStorage.setItem(COMMENT_STORAGE_KEY, JSON.stringify(savedComments)); } catch (err) {}
        }
        commentInput.value = '';
      });

      // ---------- 5. 评论点赞、点击评论或回复按钮触发回复 ----------
      commentList.addEventListener('click', function (e) {
        if (e.target.closest('a') || e.target.closest('.collapse-replies-btn')) return;
        const likeBtnTarget = e.target.closest('.comment-like-btn');
        if (likeBtnTarget) {
          const countEl = likeBtnTarget.querySelector('.comment-like-count');
          const svg = likeBtnTarget.querySelector('svg');
          const isLiked = likeBtnTarget.getAttribute('data-liked') === 'true';
          const nextLiked = !isLiked;
          likeBtnTarget.setAttribute('data-liked', String(nextLiked));
          if (svg) svg.setAttribute('fill', nextLiked ? 'currentColor' : 'none');
          likeBtnTarget.classList.toggle('text-error', nextLiked);
          likeBtnTarget.classList.toggle('text-light-on-surface-variant', !nextLiked);
          if (countEl) {
            const cur = parseInt(countEl.textContent, 10) || 0;
            countEl.textContent = String(cur + (nextLiked ? 1 : -1));
          }
          return;
        }
        const replyTrigger = e.target.closest('.comment-reply-btn') || e.target.closest('.sub-comment-item') || e.target.closest('.comment-item');
        if (replyTrigger) {
          const author = replyTrigger.getAttribute('data-reply-author') || '该用户';
          const parentLi = replyTrigger.closest('li');
          replyTarget = { author: author, li: parentLi };
          commentInput.placeholder = '回复 @' + author + '...';
          commentInput.focus();
        }
      });

      const likeBtn = document.getElementById('detail-like-btn');
      const likeSvg = document.getElementById('detail-like-svg');
      const likeCount = document.getElementById('detail-like-count');
      let liked = false;
      likeBtn.addEventListener('click', function () {
        liked = !liked;
        likeSvg.setAttribute('fill', liked ? 'currentColor' : 'none');
        likeSvg.classList.toggle('text-error', liked);
        likeCount.textContent = liked ? '3.3万' : '3.2万';
      });

      const collectBtn = document.getElementById('detail-collect-btn');
      const collectSvg = document.getElementById('detail-collect-svg');
      const collectCount = document.getElementById('detail-collect-count');
      let collected = false;
      collectBtn.addEventListener('click', function () {
        collected = !collected;
        collectSvg.setAttribute('fill', collected ? 'currentColor' : 'none');
        collectSvg.classList.toggle('text-warning', collected);
        collectCount.textContent = collected ? '1.2万' : '1.1万';
      });

      // ---------- 6. 分享底栏抽屉（平台好友 / 微信 / QQ / 复制链接） ----------
      const shareBtn = document.getElementById('detail-share-btn');
      const shareCountEl = document.getElementById('detail-share-count');
      const shareSheet = document.getElementById('share-sheet');
      const shareBackdrop = document.getElementById('share-backdrop');
      const shareCloseBtn = document.getElementById('share-close-btn');
      const shareCancelBtn = document.getElementById('share-cancel-btn');
      let shareCount = 110;

      function openShareSheet() {
        if (shareSheet) shareSheet.classList.remove('hidden');
      }
      function closeShareSheet() {
        if (shareSheet) shareSheet.classList.add('hidden');
      }

      if (shareBtn) shareBtn.addEventListener('click', openShareSheet);
      if (shareBackdrop) shareBackdrop.addEventListener('click', closeShareSheet);
      if (shareCloseBtn) shareCloseBtn.addEventListener('click', closeShareSheet);
      if (shareCancelBtn) shareCancelBtn.addEventListener('click', closeShareSheet);

      document.querySelectorAll('.share-channel-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const ch = btn.getAttribute('data-share-channel');
          shareCount += 1;
          if (shareCountEl) shareCountEl.textContent = String(shareCount);
          closeShareSheet();
          if (ch === 'copy') {
            try { navigator.clipboard && navigator.clipboard.writeText(window.location.href); } catch (e) {}
            showDetailToast('链接已复制，快去分享给好友吧');
          } else if (ch === 'platform') {
            showDetailToast('已预留「发给平台好友」分享接口');
          } else if (ch === 'wechat') {
            showDetailToast('已预留「分享至微信好友」接口');
          } else if (ch === 'qq') {
            showDetailToast('已预留「分享至 QQ 好友」接口');
          }
        });
      });

      // ---------- 7. 一键复制正文设定到剪贴板 ----------
      const copyBtn = document.getElementById('detail-copy-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          const articleEl = document.querySelector('article');
          const textToCopy = articleEl ? articleEl.innerText.trim() : '《京华深处》';
          try { navigator.clipboard && navigator.clipboard.writeText(textToCopy); } catch (e) {}
          showDetailToast('已复制设定正文到剪贴板');
        });
      }

      // ---------- 8. 离线缓存至「我的岛屿库」 ----------
      const downloadBtn = document.getElementById('detail-download-btn');
      const downloadLabel = document.getElementById('detail-download-label');
      let downloaded = false;
      if (downloadBtn) {
        downloadBtn.addEventListener('click', function () {
          downloaded = !downloaded;
          downloadBtn.classList.toggle('text-light-secondary', downloaded);
          if (downloadLabel) downloadLabel.textContent = downloaded ? '已缓存' : '下载';
          showDetailToast(downloaded ? '已离线缓存至「我的岛屿库」' : '已取消离线缓存');
        });
      }

      // ---------- 9. 作品附件预览提示 ----------
      const attachmentViewBtn = document.getElementById('attachment-view-btn');
      if (attachmentViewBtn) {
        attachmentViewBtn.addEventListener('click', function () {
          showDetailToast('正在打开附件《京华深处》角色设定集.pdf');
        });
      }

      // ---------- 10. 正文字数动态统计 ----------
      const wordCountPill = document.getElementById('article-word-count-pill');
      if (wordCountPill) {
        const bodySections = document.querySelectorAll('article > section:not(#work-attachment-section):not(#comments-section)');
        let totalChars = 0;
        bodySections.forEach(function (sec) {
          totalChars += (sec.textContent || '').replace(/\s+/g, '').length;
        });
        if (totalChars > 0) {
          wordCountPill.textContent = '共 ' + totalChars + ' 字';
        }
      }

      // ---------- 11. 页内正文关键词搜索（高亮 + 上下定位 + 跳转全站搜索） ----------
      const openSearchBtn = document.getElementById('open-article-search-btn');
      const closeSearchBtn = document.getElementById('close-article-search-btn');
      const articleSearchBar = document.getElementById('article-search-bar');
      const articleSearchInput = document.getElementById('article-search-input');
      const articleSearchCount = document.getElementById('article-search-count');
      const articleSearchPrev = document.getElementById('article-search-prev');
      const articleSearchNext = document.getElementById('article-search-next');
      const articleGlobalLink = document.getElementById('article-global-search-link');
      const searchableParagraphs = Array.from(document.querySelectorAll('article > section:not(#work-attachment-section):not(#comments-section) p, article > section:not(#work-attachment-section):not(#comments-section) h2'));
      const originalHtmlMap = new Map();
      searchableParagraphs.forEach(function (el) { originalHtmlMap.set(el, el.innerHTML); });

      let matchMarks = [];
      let activeMatchIdx = -1;

      function clearArticleHighlights() {
        searchableParagraphs.forEach(function (el) {
          if (originalHtmlMap.has(el)) el.innerHTML = originalHtmlMap.get(el);
        });
        matchMarks = [];
        activeMatchIdx = -1;
        if (articleSearchCount) articleSearchCount.textContent = '0/0';
      }

      function focusMatch(idx) {
        if (!matchMarks.length) return;
        activeMatchIdx = (idx + matchMarks.length) % matchMarks.length;
        matchMarks.forEach(function (m, i) {
          m.className = i === activeMatchIdx
            ? 'bg-light-secondary text-light-on-secondary rounded-xs px-0.5'
            : 'bg-warning/30 text-light-on-surface rounded-xs px-0.5';
        });
        if (articleSearchCount) articleSearchCount.textContent = (activeMatchIdx + 1) + '/' + matchMarks.length;
        matchMarks[activeMatchIdx].scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      function runArticleSearch(query) {
        clearArticleHighlights();
        const q = (query || '').trim();
        if (articleGlobalLink) {
          articleGlobalLink.href = '../51-global-search/GlobalSearch.html?scope=works' + (q ? '&q=' + encodeURIComponent(q) : '');
        }
        if (!q) return;
        const safeQ = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(safeQ, 'gi');
        searchableParagraphs.forEach(function (el) {
          const text = el.textContent || '';
          if (re.test(text)) {
            re.lastIndex = 0;
            el.innerHTML = text.replace(re, function (m) {
              return '<mark class="bg-warning/30 text-light-on-surface rounded-xs px-0.5">' + m + '</mark>';
            });
          }
        });
        matchMarks = Array.from(document.querySelectorAll('article mark'));
        if (matchMarks.length) focusMatch(0);
      }

      if (openSearchBtn && articleSearchBar) {
        openSearchBtn.addEventListener('click', function () {
          const willShow = articleSearchBar.classList.contains('hidden');
          articleSearchBar.classList.toggle('hidden', !willShow);
          if (willShow && articleSearchInput) {
            setTimeout(function () { articleSearchInput.focus(); }, 60);
          } else {
            clearArticleHighlights();
          }
        });
      }
      if (closeSearchBtn && articleSearchBar) {
        closeSearchBtn.addEventListener('click', function () {
          articleSearchBar.classList.add('hidden');
          if (articleSearchInput) articleSearchInput.value = '';
          clearArticleHighlights();
        });
      }
      if (articleSearchInput) {
        articleSearchInput.addEventListener('input', function () {
          runArticleSearch(articleSearchInput.value);
        });
      }
      if (articleSearchPrev) articleSearchPrev.addEventListener('click', function () { focusMatch(activeMatchIdx - 1); });
      if (articleSearchNext) articleSearchNext.addEventListener('click', function () { focusMatch(activeMatchIdx + 1); });
    })();
  </script>


