    <!-- ==================== 3. 底部六大配件工具栏（图片 / 链接 / 文档 / 投票 / 悬赏 / 音乐） ==================== -->
    <footer class="shrink-0 z-20 bg-light-surface border-t border-light-outline-variant px-gutter-md pt-gutter-sm pb-gutter-lg">
      <div class="grid grid-cols-6 items-center gap-1">
        <button type="button" data-target="mod-image" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.8"></rect>
            <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor"></circle>
            <path d="M4.5 17L9.5 12L13.5 15.5L16.5 13L19.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="font-label text-label-sm">图片</span>
        </button>

        <button type="button" data-target="mod-link" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface-variant hover:text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M10 14L14 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M13.5 15.5L11.5 17.5C9.84 19.16 7.16 19.16 5.5 17.5C3.84 15.84 3.84 13.16 5.5 11.5L7.5 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M10.5 8.5L12.5 6.5C14.16 4.84 16.84 4.84 18.5 6.5C20.16 8.16 20.16 10.84 18.5 12.5L16.5 14.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span class="font-label text-label-sm">链接</span>
        </button>

        <button type="button" data-target="mod-doc" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 3.75H14.5L18.5 7.75V19.25C18.5 19.94 17.94 20.5 17.25 20.5H6.5C5.81 20.5 5.25 19.94 5.25 19.25V5C5.25 4.31 5.81 3.75 6.5 3.75Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            <path d="M9 12H15M9 15.5H13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span class="font-label text-label-sm">文档</span>
        </button>

        <button type="button" data-target="mod-poll" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19V11M12 19V5M19 19V14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="font-label text-label-sm">投票</span>
        </button>

        <button type="button" data-target="mod-bounty" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface-variant hover:text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M9.5 10.2C9.5 8.9 10.6 8 12 8C13.4 8 14.5 8.9 14.5 10.2C14.5 11.4 13.5 12 12 12C10.5 12 9.5 12.6 9.5 13.8C9.5 15.1 10.6 16 12 16C13.4 16 14.5 15.1 14.5 13.8M12 6.5V17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <span class="font-label text-label-sm">悬赏</span>
        </button>

        <button type="button" data-target="mod-music" class="mod-toggle-btn py-1.5 rounded-md flex flex-col items-center gap-1 text-light-on-surface-variant hover:text-light-on-surface hover:bg-light-surface-container transition-colors duration-state-change">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 17.5V6.5L19 4.5V15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="6.75" cy="17.5" r="2.25" stroke="currentColor" stroke-width="1.8"></circle>
            <circle cx="16.75" cy="15.5" r="2.25" stroke="currentColor" stroke-width="1.8"></circle>
          </svg>
          <span class="font-label text-label-sm">音乐</span>
        </button>
      </div>
    </footer>

    <!-- [反馈] 轻提示 Toast -->
    <div id="compose-toast" role="status" aria-live="polite" class="pointer-events-none hidden absolute top-20 left-1/2 -translate-x-1/2 z-50 px-gutter-lg py-gutter-sm rounded-full bg-light-primary text-light-on-primary font-label text-label-sm shadow-lg whitespace-nowrap"></div>
  </main>

  <script>
    (function () {
      // ---------- 1. 轻提示反馈工具 ----------
      const toast = document.getElementById('compose-toast');
      let toastTimer = null;
      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 1800);
      }

      // ---------- 2. 话题标签输入与正文字数统计 ----------
      const textarea = document.getElementById('compose-textarea');
      const charCount = document.getElementById('char-count');
      const tagInput = document.getElementById('tag-input');
      const tagWrap = document.getElementById('tag-pills-wrap');

      function addTagChip(raw) {
        const clean = raw.replace(/^#+/, '').trim();
        if (!clean) return;
        const chip = document.createElement('span');
        chip.className = 'tag-chip inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm';
        chip.innerHTML = '<span></span><button type="button" class="remove-tag-btn text-light-on-primary/80 hover:text-light-on-primary" aria-label="移除标签">×</button>';
        chip.querySelector('span').textContent = '#' + clean;
        chip.querySelector('.remove-tag-btn').addEventListener('click', function () { chip.remove(); });
        tagWrap.insertBefore(chip, tagInput);
      }

      document.querySelectorAll('.remove-tag-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { btn.closest('.tag-chip').remove(); });
      });

      tagInput.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          if (tagInput.value.trim()) {
            addTagChip(tagInput.value);
            tagInput.value = '';
          }
        }
      });

      document.getElementById('insert-hash-btn').addEventListener('click', function () {
        if (!tagInput.value.startsWith('#')) {
          tagInput.value = '#' + tagInput.value;
        }
        tagInput.focus();
      });

      document.querySelectorAll('.quick-tag-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          addTagChip(btn.getAttribute('data-quick-tag'));
        });
      });

      function autoResizeComposeTextarea() {
        textarea.style.height = 'auto';
        textarea.style.height = Math.max(88, textarea.scrollHeight) + 'px';
      }
      textarea.addEventListener('input', function () {
        charCount.textContent = textarea.value.length + '/2000';
        autoResizeComposeTextarea();
      });
      autoResizeComposeTextarea();

      // ---------- 3. 九宫格图片上传与删除（最多 9 张） ----------
      const imgGrid = document.getElementById('img-grid');
      const imgFileInput = document.getElementById('img-file-input');
      const addMoreImgBtn = document.getElementById('add-more-img-btn');
      const imgCountLabel = document.getElementById('img-count-label');

      function updateImgCount() {
        const count = imgGrid.querySelectorAll('.img-tile').length;
        imgCountLabel.textContent = '图片配图 (' + count + '/9)';
        addMoreImgBtn.classList.toggle('hidden', count >= 9);
      }

      addMoreImgBtn.addEventListener('click', function () {
        imgFileInput.click();
      });

      imgGrid.addEventListener('click', function (e) {
        const removeBtn = e.target.closest('.remove-img-btn');
        if (!removeBtn) return;
        const tile = removeBtn.closest('.img-tile');
        if (tile) {
          tile.remove();
          updateImgCount();
        }
      });

      imgFileInput.addEventListener('change', function () {
        const files = Array.from(imgFileInput.files || []);
        if (!files.length) return;
        files.forEach(function (file) {
          if (imgGrid.querySelectorAll('.img-tile').length >= 9) return;
          const url = URL.createObjectURL(file);
          const tile = document.createElement('div');
          tile.className = 'img-tile relative aspect-square rounded-md overflow-hidden border border-light-outline-variant';
          tile.innerHTML =
            '<img src="' + url + '" alt="已选配图" class="w-full h-full object-cover">' +
            '<button type="button" aria-label="删除图片" class="remove-img-btn absolute top-1 right-1 w-5 h-5 rounded-full bg-dark-surface/75 text-light-on-primary text-body-sm flex items-center justify-center leading-none">×</button>';
          imgGrid.insertBefore(tile, addMoreImgBtn);
        });
        updateImgCount();
        imgFileInput.value = '';
        showToast('已添加配图');
      });

      // ---------- 4. 投票配件管理（增删选项与自动重排 A/B/C/D 序号） ----------
      const pollList = document.getElementById('poll-options-list');
      const letters = ['A', 'B', 'C', 'D'];

      function resequencePollOptions() {
        const rows = Array.from(pollList.querySelectorAll('.poll-opt-row'));
        rows.forEach(function (row, idx) {
          const badge = row.querySelector('.poll-letter');
          if (badge) badge.textContent = letters[idx] || String(idx + 1);
        });
      }

      pollList.addEventListener('click', function (e) {
        const removeBtn = e.target.closest('.remove-poll-opt-btn');
        if (!removeBtn) return;
        const rows = pollList.querySelectorAll('.poll-opt-row');
        if (rows.length <= 2) {
          showToast('投票至少保留 2 个选项');
          return;
        }
        const row = removeBtn.closest('.poll-opt-row');
        if (row) {
          row.remove();
          resequencePollOptions();
        }
      });

      document.getElementById('add-poll-opt-btn').addEventListener('click', function () {
        const count = pollList.querySelectorAll('.poll-opt-row').length;
        if (count >= 4) {
          showToast('最多支持 4 个投票选项');
          return;
        }
        const row = document.createElement('div');
        row.className = 'poll-opt-row flex items-center gap-1.5';
        row.innerHTML =
          '<span class="poll-letter w-6 h-6 rounded-full bg-light-surface-container font-mono text-body-sm text-light-on-surface flex items-center justify-center shrink-0">' + letters[count] + '</span>' +
          '<input type="text" placeholder="输入新选项..." class="flex-1 min-w-0 h-9 rounded-md bg-light-surface border border-light-outline-variant px-2.5 font-body text-body-sm text-light-on-surface focus:ring-1 focus:ring-light-secondary">' +
          '<button type="button" aria-label="删除选项" class="remove-poll-opt-btn w-7 h-7 rounded-full text-light-on-surface-variant hover:text-error hover:bg-light-surface flex items-center justify-center shrink-0 transition-colors">×</button>';
        pollList.appendChild(row);
      });

      const pollModeBtn = document.getElementById('poll-mode-btn');
      pollModeBtn.addEventListener('click', function () {
        pollModeBtn.textContent = pollModeBtn.textContent === '单选' ? '多选(最多2项)' : '单选';
      });

      const durations = ['24小时截止', '3天截止', '7天截止'];
      let dIdx = 1;
      const pollTimeBtn = document.getElementById('poll-time-btn');
      pollTimeBtn.addEventListener('click', function () {
        dIdx = (dIdx + 1) % durations.length;
        pollTimeBtn.textContent = durations[dIdx];
      });

      // ---------- 5. 底部六大配件开关与工具栏高亮同步 ----------
      function syncToolbarBtn(targetId, isVisible) {
        const btn = document.querySelector('.mod-toggle-btn[data-target="' + targetId + '"]');
        if (!btn) return;
        btn.classList.toggle('text-light-on-surface', isVisible);
        btn.classList.toggle('text-light-on-surface-variant', !isVisible);
      }

      document.querySelectorAll('.mod-toggle-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const targetId = btn.getAttribute('data-target');
          const target = document.getElementById(targetId);
          if (!target) return;
          const willShow = target.classList.contains('hidden');
          if (willShow) {
            target.classList.remove('hidden');
            syncToolbarBtn(targetId, true);
            target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            target.classList.add('hidden');
            syncToolbarBtn(targetId, false);
          }
        });
      });

      document.querySelectorAll('.close-mod-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const id = btn.getAttribute('data-close-mod');
          const el = document.getElementById(id);
          if (el) el.classList.add('hidden');
          syncToolbarBtn(id, false);
        });
      });

      // ---------- 6. 文档上传与扩展名自动识别（PDF / Word / TXT / MD） ----------
      const docStyles = {
        pdf:  { fill: '#FFE8E8', stroke: '#EF4444', fold: '#FECACA', badge: '#DC2626', label: 'PDF', desc: 'PDF 文档' },
        doc:  { fill: '#E8F1FF', stroke: '#3B82F6', fold: '#BFDBFE', badge: '#2563EB', label: 'DOC', desc: 'Word 文档' },
        docx: { fill: '#E8F1FF', stroke: '#3B82F6', fold: '#BFDBFE', badge: '#2563EB', label: 'DOC', desc: 'Word 文档' },
        txt:  { fill: '#F1F3F6', stroke: '#64748B', fold: '#E2E8F0', badge: '#475569', label: 'TXT', desc: '纯文本文档' },
        md:   { fill: '#F3F0FF', stroke: '#7C3AED', fold: '#DDD6FE', badge: '#6D28D9', label: 'MD',  desc: 'Markdown 文档' }
      };
      const docFileInput = document.getElementById('doc-file-input');
      document.getElementById('upload-doc-btn').addEventListener('click', function () {
        docFileInput.click();
      });

      function formatFileSize(bytes) {
        if (!bytes) return '0.2 MB';
        if (bytes < 1024 * 1024) return Math.max(1, Math.round(bytes / 1024)) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
      }

      docFileInput.addEventListener('change', function () {
        const file = docFileInput.files && docFileInput.files[0];
        if (!file) return;
        const ext = (file.name.split('.').pop() || '').toLowerCase();
        const s = docStyles[ext] || docStyles.txt;
        const svg = document.getElementById('doc-preview-icon');
        const paths = svg.querySelectorAll('path');
        paths[0].setAttribute('fill', s.fill);
        paths[0].setAttribute('stroke', s.stroke);
        paths[1].setAttribute('fill', s.fold);
        paths[1].setAttribute('stroke', s.stroke);
        svg.querySelector('rect').setAttribute('fill', s.badge);
        svg.querySelector('text').textContent = s.label;
        document.getElementById('doc-file-name').textContent = file.name;
        document.getElementById('doc-file-meta').textContent = formatFileSize(file.size) + ' · ' + s.desc;
        docFileInput.value = '';
        showToast('已识别 ' + s.label + ' 文档');
      });

      // ---------- 7. 悬赏金额预设与截稿周期切换 ----------
      const bountyInput = document.getElementById('bounty-amount-input');
      const bountyPresetBtns = Array.from(document.querySelectorAll('.bounty-preset-btn'));
      function syncBountyPresets(val) {
        bountyPresetBtns.forEach(function (b) {
          const active = b.getAttribute('data-amount') === String(val);
          b.classList.toggle('bg-light-primary', active);
          b.classList.toggle('text-light-on-primary', active);
          b.classList.toggle('border-light-primary', active);
          b.classList.toggle('bg-light-surface', !active);
          b.classList.toggle('text-light-on-surface-variant', !active);
          b.classList.toggle('border-light-outline-variant', !active);
        });
      }
      bountyPresetBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const amt = btn.getAttribute('data-amount') || '50';
          bountyInput.value = amt;
          syncBountyPresets(amt);
        });
      });
      bountyInput.addEventListener('input', function () {
        syncBountyPresets(bountyInput.value.trim());
      });

      const bountyDeadlines = ['3天截稿', '7天截稿', '15天截稿'];
      let bIdx = 1;
      const bountyDeadlineBtn = document.getElementById('bounty-deadline-btn');
      bountyDeadlineBtn.addEventListener('click', function () {
        bIdx = (bIdx + 1) % bountyDeadlines.length;
        bountyDeadlineBtn.textContent = bountyDeadlines[bIdx];
      });

      // ---------- 8. 本地音频上传与迷你音乐播放器控制 ----------
      const musicFileInput = document.getElementById('music-file-input');
      const musicEmptyState = document.getElementById('music-empty-state');
      const musicPlayerCard = document.getElementById('music-player-card');
      const musicAudio = document.getElementById('music-audio');
      const musicPlayBtn = document.getElementById('music-play-btn');
      const musicPlayIcon = document.getElementById('music-play-icon');
      const musicProgressBar = document.getElementById('music-progress-bar');
      const musicTimeLabel = document.getElementById('music-time-label');

      function formatAudioTime(sec) {
        if (!isFinite(sec) || sec < 0) return '00:00';
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
      }

      function setMusicPlayIcon(playing) {
        musicPlayerCard.classList.toggle('is-playing', playing);
        musicPlayIcon.innerHTML = playing
          ? '<rect x="7" y="5.5" width="3.5" height="13" rx="1"/><rect x="13.5" y="5.5" width="3.5" height="13" rx="1"/>'
          : '<path d="M8 5.5V18.5L18.5 12L8 5.5Z"/>';
      }

      document.getElementById('upload-music-btn').addEventListener('click', function () {
        musicFileInput.click();
      });
      document.getElementById('change-music-btn').addEventListener('click', function () {
        musicFileInput.click();
      });

      musicFileInput.addEventListener('change', function () {
        const file = musicFileInput.files && musicFileInput.files[0];
        if (!file) return;
        const cleanTitle = file.name.replace(/\.[^.]+$/, '');
        const ext = (file.name.split('.').pop() || 'AUDIO').toUpperCase();
        document.getElementById('music-title').textContent = cleanTitle;
        document.getElementById('music-meta').textContent = ext + ' · ' + formatFileSize(file.size);
        musicAudio.src = URL.createObjectURL(file);
        musicProgressBar.style.width = '0%';
        musicTimeLabel.textContent = '00:00 / 00:00';
        setMusicPlayIcon(false);
        musicEmptyState.classList.add('hidden');
        musicPlayerCard.classList.remove('hidden');
        musicFileInput.value = '';
        showToast('背景音乐已上传');
      });

      musicAudio.addEventListener('loadedmetadata', function () {
        musicTimeLabel.textContent = '00:00 / ' + formatAudioTime(musicAudio.duration);
      });
      musicAudio.addEventListener('timeupdate', function () {
        const pct = musicAudio.duration ? Math.min(100, (musicAudio.currentTime / musicAudio.duration) * 100) : 0;
        musicProgressBar.style.width = pct + '%';
        musicTimeLabel.textContent = formatAudioTime(musicAudio.currentTime) + ' / ' + formatAudioTime(musicAudio.duration);
      });
      musicAudio.addEventListener('ended', function () {
        setMusicPlayIcon(false);
        musicProgressBar.style.width = '0%';
      });

      musicPlayBtn.addEventListener('click', function () {
        if (!musicAudio.src) return;
        if (musicAudio.paused) {
          musicAudio.play().then(function () {
            setMusicPlayIcon(true);
          }).catch(function () {
            showToast('请先上传有效音频文件');
          });
        } else {
          musicAudio.pause();
          setMusicPlayIcon(false);
        }
      });

      // ---------- 9. 网页链接域名识别与发布跳转 ----------
      document.getElementById('parse-link-btn').addEventListener('click', function () {
        const val = document.getElementById('link-url-input').value.trim();
        if (val) {
          document.getElementById('link-domain-preview').textContent = val.replace(/^https?:\/\//, '').split('/')[0];
          showToast('已识别网页链接卡片');
        }
      });

      document.getElementById('publish-btn').addEventListener('click', function () {
        showToast('动态已发布，即将返回社区');
        setTimeout(function () {
          window.location.href = '../18-community/Community.html';
        }, 700);
      });
    })();
  </script>


