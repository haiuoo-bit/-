  <script>
    (function () {
      const tabs = document.querySelectorAll('.off-tab');
      const cards = document.querySelectorAll('.off-card');
      const readAllBtn = document.getElementById('off-read-all-btn');
      const toast = document.getElementById('off-toast');
      let toastTimer = null;

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const kind = tab.dataset.kind;
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('bg-light-primary', active);
            t.classList.toggle('text-light-on-primary', active);
            t.classList.toggle('bg-light-surface-container', !active);
            t.classList.toggle('text-light-on-surface-variant', !active);
          });
          cards.forEach((card) => {
            card.classList.toggle('hidden', kind !== 'all' && card.dataset.kind !== kind);
          });
        });
      });

      if (readAllBtn) {
        readAllBtn.addEventListener('click', () => {
          document.querySelectorAll('.off-dot').forEach((d) => d.classList.add('hidden'));
          showToast('已将官方信息全部标为已读');
        });
      }
    })();
