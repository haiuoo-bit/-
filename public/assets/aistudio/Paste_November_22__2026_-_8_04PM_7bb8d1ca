      var btnLater = document.getElementById('btn-later');
      var btnCloseX = document.getElementById('btn-close-x');
      var btnBgDownload = document.getElementById('btn-bg-download');
      var idleActions = document.getElementById('idle-actions');
      var progressBox = document.getElementById('download-progress-box');
      var ringProgress = document.getElementById('ring-progress');
      var ringIcon = document.getElementById('ring-icon');
      var statusText = document.getElementById('download-status-text');
      var percentText = document.getElementById('download-percent');
      var bar = document.getElementById('download-bar');
      var toast = document.getElementById('toast');
      var toastText = document.getElementById('toast-text');

      var CIRCUMFERENCE = 69.12; // 环形进度条周长（2 * π * 11）
      var timer = null;
      var toastTimer = null;

      // 页面进入时自动弹出更新提示框
      if (modalUpdate && typeof modalUpdate.showModal === 'function') {
        modalUpdate.showModal();
      }

      // ---------- 2. 全局轻提示 Toast 控制 ----------
      function showToast(msg) {
        toastText.textContent = msg;
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2600);
      }

      var isDownloadDone = false;

      // ---------- 3. 点击「下载并安装」后切换进度视图并模拟下载 ----------
      btnUpdate.addEventListener('click', function () {
        idleActions.classList.add('hidden');
        progressBox.classList.remove('hidden');
        isDownloadDone = false;
        var pct = 1;
        timer = setInterval(function () {
          pct += Math.floor(Math.random() * 14) + 10;
          if (pct >= 100) {
            pct = 100;
            isDownloadDone = true;
            clearInterval(timer);
            ringIcon.textContent = 'check';
            statusText.textContent = '下载完成，已就绪';
            // 下载完成后将「后台下载」按钮切换为主色「立即安装」
            if (btnBgDownload) {
              btnBgDownload.className = 'w-full h-11 px-gutter-xl rounded-full bg-light-primary text-light-on-primary flex items-center justify-center transition-transform duration-state-change active:scale-[0.98] shadow-sm';
              var lbl = btnBgDownload.querySelector('span');
              if (lbl) lbl.textContent = '立即安装';
            }
            showToast('下载完成，可点击立即安装');
          } else {
            ringIcon.textContent = 'arrow_downward';
            statusText.textContent = '正在下载更新包...';
          }
          ringProgress.style.strokeDashoffset = (CIRCUMFERENCE * (1 - pct / 100)).toFixed(2);
          percentText.textContent = pct + '%';
          bar.style.width = pct + '%';
        }, 180);
      });

      // ---------- 4. 收起弹窗与重新打开控制 ----------
      function dismissModal(msg) {
        if (timer) clearInterval(timer);
        if (modalUpdate && typeof modalUpdate.close === 'function') {
          modalUpdate.close();
        }
        reopenBar.classList.remove('hidden');
        showToast(msg || '已暂缓更新，可在设置中随时检查新版本');
      }

      btnLater.addEventListener('click', function () { dismissModal('已暂缓更新，可在设置中随时检查新版本'); });
      if (btnCloseX) {
        btnCloseX.addEventListener('click', function () { dismissModal('已暂缓更新，可在设置中随时检查新版本'); });
      }
      if (btnBgDownload) {
        btnBgDownload.addEventListener('click', function () {
          if (isDownloadDone) {
            showToast('正在拉起系统安装界面...');
          } else {
            dismissModal('已切换至后台继续下载');
          }
        });
      }

      // 点击页面悬浮按钮重新唤起更新弹窗
      btnReopen.addEventListener('click', function () {
        reopenBar.classList.add('hidden');
        if (modalUpdate && typeof modalUpdate.showModal === 'function') {
          modalUpdate.showModal();
        }
      });
    })();
  </script>


