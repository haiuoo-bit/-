        });
      });

      // ---------- 4. 每日 3 票打榜投票与撤回交互 ----------
      let remainingVotes = 3;
      const remainingLabel = document.getElementById('remaining-votes-label');
      function updateRemainingLabel() {
        if (remainingLabel) {
          remainingLabel.textContent = '今日余 ' + remainingVotes + ' 票';
        }
      }

      document.querySelectorAll('.vote-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const voted = btn.getAttribute('data-voted') === 'true';
          if (!voted && remainingVotes <= 0) {
            showToast('今日 3 票已用完，明日 0 点刷新');
            return;
          }
          let count = parseInt(btn.getAttribute('data-votes'), 10) || 0;
          count = voted ? count - 1 : count + 1;
          remainingVotes = voted ? remainingVotes + 1 : remainingVotes - 1;
          updateRemainingLabel();
          btn.setAttribute('data-votes', String(count));
          btn.setAttribute('data-voted', voted ? 'false' : 'true');
          btn.textContent = voted ? '投票' : '已投票';
          btn.classList.toggle('opacity-70', !voted);
          const card = btn.closest('div').parentElement;
          const label = card.querySelector('.vote-count');
          if (label) {
            label.textContent = count.toLocaleString() + ' 票';
          }
          showToast(voted ? '已撤回投票' : '投票成功！今日剩余 ' + remainingVotes + ' 票');
        });
      });
    })();
