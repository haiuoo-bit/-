              <path d="M9 10C9 6.69 11.69 4 15 4H27.2C28.53 4 29.8 4.53 30.74 5.46L37.54 12.26C38.47 13.2 39 14.47 39 15.8V38C39 41.31 36.31 44 33 44H15C11.69 44 9 41.31 9 38V10Z" fill="#F3F0FF" stroke="#7C3AED" stroke-width="1.6"></path>
              <path d="M28 4.2V11C28 12.66 29.34 14 31 14H38.8" fill="#DDD6FE" stroke="#7C3AED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M15.5 19H24.5M15.5 23H21.5" stroke="#C4B5FD" stroke-width="2" stroke-linecap="round"></path>
              <rect x="12" y="27.5" width="24" height="12" rx="6" fill="#6D28D9"></rect>
              <text x="24" y="36" text-anchor="middle" fill="#FFFFFF" font-family="Plus Jakarta Sans, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.4">MD</text>
