  <script>
    (function () {
      // ---------- 1. 全局轻提示 Toast ----------
      var toast = document.getElementById('emu-toast');
      var toastTimer = null;
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.classList.add('hidden');
        }, 2200);
      }

      // ---------- 2. 分类胶囊筛选 ----------
      var catButtons = document.querySelectorAll('.emu-cat-btn');
      var cards = document.querySelectorAll('.emu-card');
      catButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetCat = btn.getAttribute('data-cat');
          catButtons.forEach(function (b) {
            var active = b === btn;
            b.setAttribute('aria-selected', active ? 'true' : 'false');
            if (active) {
              b.classList.remove('bg-light-surface-container', 'text-light-on-surface-variant');
              b.classList.add('bg-light-primary', 'text-light-on-primary');
            } else {
              b.classList.remove('bg-light-primary', 'text-light-on-primary');
              b.classList.add('bg-light-surface-container', 'text-light-on-surface-variant');
            }
          });
          cards.forEach(function (card) {
            var cat = card.getAttribute('data-category');
            if (targetCat === 'all' || cat === targetCat) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });

      // ---------- 3. 平台内下载进度模拟 ----------
      var activeTimers = {};
      document.querySelectorAll('.emu-download-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-emu-id');
          var name = btn.getAttribute('data-emu-name');
          var totalSize = parseFloat(btn.getAttribute('data-emu-size')) || 40;
          var label = btn.querySelector('.emu-btn-label');
          var box = document.getElementById('prog-box-' + id);

          if (btn.getAttribute('data-done') === '1') {
            showToast(name + ' 已就绪，可随时打开安装');
            return;
          }
          if (activeTimers[id]) return;

          if (box) box.classList.remove('hidden');
          var bar = box ? box.querySelector('.prog-bar') : null;
          var pctEl = box ? box.querySelector('.prog-pct') : null;
          var statusEl = box ? box.querySelector('.prog-status') : null;

          var pct = 0;
          if (label) label.textContent = '下载中 0%';
          activeTimers[id] = setInterval(function () {
            pct += 16;
            if (pct >= 100) {
              pct = 100;
              clearInterval(activeTimers[id]);
              delete activeTimers[id];
              btn.setAttribute('data-done', '1');
              if (label) label.textContent = '下载完成 · 立即安装';
              if (statusEl) statusEl.textContent = '校验通过，已保存至本地下载';
              showToast(name + ' 下载完成');
            } else {
              if (label) label.textContent = '下载中 ' + pct + '%';
            }
            var currentMb = (totalSize * pct / 100).toFixed(1);
            if (bar) bar.style.width = pct + '%';
            if (pctEl) pctEl.textContent = currentMb + ' / ' + totalSize.toFixed(1) + ' MB';
          }, 180);
        });
      });

      // ---------- 4. 复制下载链接 ----------
      document.querySelectorAll('.emu-copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var url = btn.getAttribute('data-copy-url');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).catch(function () {});
          }
          showToast('已复制下载链接');
        });
      });

      // ---------- 5. 收费模拟器先购买后解锁 ----------
      document.querySelectorAll('.emu-buy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          var id = btn.getAttribute('data-emu-id');
          var name = btn.getAttribute('data-emu-name');
          var span = btn.querySelector('span');
          btn.disabled = true;
          if (span) span.textContent = '正在支付并解锁…';
          setTimeout(function () {
            btn.classList.add('hidden');
            var unlocked = document.getElementById('unlocked-actions-' + id);
            if (unlocked) unlocked.classList.remove('hidden');
            showToast(name + ' 购买成功，已解锁下载并同步至「我的岛屿库」');
          }, 900);
        });
      });

      // ---------- 6. 安装指引弹窗开关 ----------
      var modal = document.getElementById('emu-guide-modal');
      function openGuide() { if (modal) modal.classList.remove('hidden'); }
      function closeGuide() { if (modal) modal.classList.add('hidden'); }
      document.getElementById('emu-help-btn').addEventListener('click', openGuide);
      document.getElementById('emu-guide-backdrop').addEventListener('click', closeGuide);
      document.getElementById('close-guide-btn').addEventListener('click', closeGuide);
      document.getElementById('confirm-guide-btn').addEventListener('click', closeGuide);
    })();
  </script>


