        clearTimeout(tipTimer);
      }

      // 触发未勾选协议提醒：协议行轻晃 + 红色高亮 + 显示顶部气泡
      function highlightAgreeWarning() {
        agreeRow.classList.remove('animate-agree-shake');
        void agreeRow.offsetWidth; // 强制重排以重新触发 CSS 动画
        agreeRow.classList.add('bg-error/10', 'border-error/30', 'animate-agree-shake');
        if (agreeTip) {
          agreeTip.classList.remove('hidden');
          clearTimeout(tipTimer);
          tipTimer = setTimeout(function () {
            agreeTip.classList.add('hidden');
          }, 2200);
        }
      }

      // 页面初始化时恢复之前的勾选状态
      try {
        if (sessionStorage.getItem('rsdy_agreed') === '1') {
          agreeCheckbox.checked = true;
        }
      } catch (e) {}

      // 监听勾选框变化
      agreeCheckbox.addEventListener('change', function () {
        syncAgreementStorage(agreeCheckbox.checked);
        if (agreeCheckbox.checked) {
          clearAgreeWarning();
        }
      });

      // 重置一键登录按钮状态
      function resetLoginLoading() {
        clearTimeout(loginTimer);
        loginTimer = null;
        oneClickBtn.disabled = false;
        oneClickSpinner.classList.add('hidden');
        oneClickLabel.textContent = '一键登录';
        if (otherPhoneLink) otherPhoneLink.classList.remove('pointer-events-none', 'opacity-50');
      }

      // 执行一键登录加载流程：仅按钮本身转圈加载 -> 直接进入首页
      function triggerLogin() {
        if (oneClickBtn.disabled) return;
        oneClickBtn.disabled = true;
        oneClickSpinner.classList.remove('hidden');
        oneClickLabel.textContent = '正在登录...';
        if (otherPhoneLink) otherPhoneLink.classList.add('pointer-events-none', 'opacity-50');

        loginTimer = setTimeout(function () {
          resetLoginLoading();
          window.location.href = '../06-home-feed/HomeFeed.html';
        }, 650);
      }

      // 点击「一键登录」主按钮
      oneClickBtn.addEventListener('click', function () {
        if (!agreeCheckbox.checked) {
          highlightAgreeWarning();
          modalAgreement.showModal();
        } else {
          triggerLogin();
        }
      });

      // 未勾选弹窗 -> 点击「暂不同意」
      document.getElementById('modal-agreement-cancel').addEventListener('click', function () {
        modalAgreement.close();
      });

      // 未勾选弹窗 -> 点击「同意并登录」
      document.getElementById('modal-agreement-confirm').addEventListener('click', function () {
        agreeCheckbox.checked = true;
        syncAgreementStorage(true);
        clearAgreeWarning();
        modalAgreement.close();
        triggerLogin();
      });

      // 协议抽屉对应文案配置
      const POLICY_TEXTS = {
        '用户协议': [
          '欢迎使用「人设岛遇」服务。在注册或登录前，请仔细阅读本协议条款，了解您的权利与义务。',
          '1. 本机号码一键登录由运营商提供安全加密校验，仅用于当前设备身份核验。',
          '2. 您在平台创作或互动的内容应遵守社区规范，保护原创作者权益。'
        ],
        '隐私协议': [
          '「人设岛遇」高度重视您的个人信息与隐私保护，我们将严格遵循最小必要原则收集信息。',
          '1. 手机号仅用于账号注册、登录认证及安全找回，不会向无关第三方泄露。',
          '2. 您的个人设定与私密创作默认受本地及加密权限保护，可随时在设置中管理。'
        ]
      };

      // 点击《用户协议》或《隐私协议》文字按钮：打开抽屉并渲染对应条款
      document.querySelectorAll('.policy-link').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          const policyName = btn.getAttribute('data-policy') || '协议详情';
          modalPolicyTitle.textContent = policyName;
          const lines = POLICY_TEXTS[policyName] || POLICY_TEXTS['用户协议'];
          modalPolicyContent.innerHTML = lines.map(function (line) {
            return '<p data-design-text-token="body-sm">' + line + '</p>';
          }).join('');
          modalPolicy.showModal();
        });
      });

      // 协议抽屉 -> 点击右上角关闭
      document.getElementById('modal-policy-close').addEventListener('click', function () {
        modalPolicy.close();
      });

      // 协议抽屉 -> 点击「已阅读并同意」
      document.getElementById('modal-policy-agree').addEventListener('click', function () {
        agreeCheckbox.checked = true;
        syncAgreementStorage(true);
        clearAgreeWarning();
        modalPolicy.close();
      });
    })();
  </script>


