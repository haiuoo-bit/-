  <script>
    (function () {
      // ---------- 1. 榜单顶部轮播图自动切换与圆点控制 ----------
      const track = document.getElementById('rank-carousel-track');
      const dots = Array.from(document.querySelectorAll('.rank-carousel-dot'));
      let currentSlide = 0;
      const totalSlides = dots.length;

      function goToSlide(idx) {
        if (!track || !totalSlides) return;
        currentSlide = (idx + totalSlides) % totalSlides;
        track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
        dots.forEach(function (d, i) {
          d.classList.toggle('w-4', i === currentSlide);
          d.classList.toggle('w-1.5', i !== currentSlide);
          d.classList.toggle('bg-dark-on-surface', i === currentSlide);
          d.classList.toggle('bg-dark-on-surface/50', i !== currentSlide);
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goToSlide(parseInt(dot.getAttribute('data-slide'), 10) || 0);
        });
      });

      if (totalSlides > 1) {
        setInterval(function () { goToSlide(currentSlide + 1); }, 4500);
      }

      // ---------- 2. Toast 轻提示控制 ----------
      const toast = document.getElementById('rank-toast');
      let toastTimer = null;
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 1800);
      }

      // ---------- 3. 四大子榜演示数据集与 Tab 切换刷新 ----------
      const boardData = {
