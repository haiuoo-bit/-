              <span class="font-label text-label-sm text-warning font-bold shrink-0">元</span>
              <input id="bounty-amount-input" type="number" value="50" min="5" placeholder="输入悬赏金额，如 100" class="flex-1 min-w-0 bg-transparent border-0 p-0 font-mono text-body-md text-light-on-surface font-bold focus:ring-0 tabular-nums">
