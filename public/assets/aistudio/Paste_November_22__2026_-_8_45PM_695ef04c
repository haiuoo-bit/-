  <script>
    (function () {
      const tabs = document.querySelectorAll('.order-tab');
      const cards = document.querySelectorAll('.order-card');
      const readAllBtn = document.getElementById('comm-read-all-btn');
      const toast = document.getElementById('order-toast');
      let toastTimer = null;

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      // 双向角色筛选：全部 / 我约的稿 / 我接的单
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const role = tab.dataset.role;
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('bg-light-primary', active);
            t.classList.toggle('text-light-on-primary', active);
            t.classList.toggle('bg-light-surface-container', !active);
            t.classList.toggle('text-light-on-surface-variant', !active);
          });
          cards.forEach((card) => {
            card.classList.toggle('hidden', role !== 'all' && card.dataset.role !== role);
          });
        });
      });

      if (readAllBtn) {
        readAllBtn.addEventListener('click', () => {
          document.querySelectorAll('.order-dot').forEach((d) => d.classList.add('hidden'));
          showToast('已将接单通知全部标为已读');
        });
      }

      document.getElementById('order-list').addEventListener('click', (e) => {
        const rejectBtn = e.target.closest('.order-reject-btn');
        if (rejectBtn) {
          const card = rejectBtn.closest('.order-card');
          const statusEl = card.querySelector('.order-status');
          if (statusEl) {
            statusEl.textContent = '已拒绝';
            statusEl.className = 'order-status px-2 py-0.5 rounded-full bg-error/15 text-error font-label text-label-sm shrink-0';
          }
          rejectBtn.textContent = '已拒绝';
          rejectBtn.disabled = true;
          rejectBtn.className = 'h-8 px-3 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm';
          const acceptSibling = card.querySelector('.order-accept-btn');
          if (acceptSibling) acceptSibling.classList.add('hidden');
          showToast('已拒绝该约稿申请');
          return;
        }
        const acceptBtn = e.target.closest('.order-accept-btn');
        if (acceptBtn) {
          const card = acceptBtn.closest('.order-card');
          const statusEl = card.querySelector('.order-status');
          if (statusEl) {
            statusEl.textContent = '进行中';
            statusEl.className = 'order-status px-2 py-0.5 rounded-full bg-success text-light-on-primary font-label text-label-sm shrink-0';
          }
          acceptBtn.textContent = '已接单';
          acceptBtn.disabled = true;
          acceptBtn.className = 'h-8 px-3.5 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm';
          const rejectSibling = card.querySelector('.order-reject-btn');
          if (rejectSibling) rejectSibling.classList.add('hidden');
          showToast('接单成功，已通知约稿方');
          return;
        }
        const confirmBtn = e.target.closest('.order-confirm-btn');
        if (confirmBtn) {
          const card = confirmBtn.closest('.order-card');
          const statusEl = card.querySelector('.order-status');
          if (statusEl) {
            statusEl.textContent = '已完成';
            statusEl.className = 'order-status px-2 py-0.5 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm shrink-0';
          }
          confirmBtn.textContent = '已验收';
          confirmBtn.disabled = true;
          confirmBtn.className = 'h-8 px-3.5 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm';
          showToast('验收完成，款项已结算给创作者');
        }
      });
    })();
  </script>


