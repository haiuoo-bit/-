          { id: 'g2', groupNo: '661042', name: '古风权谋脑洞茶话会', owner: '零度写作', avatar: 'https://lh3.googleusercontent.com/aida/ALJJyrC4TSrdR4t-HQLJedtAU4ZXAayanN12DleADeM4QyKmu3zCm9HdkCEaRH3u9D_xjs_rvb4w4JtZVBNHC27HiYGM8otOqOfMA1cWkJsM8z4hyNzc355KRe3-UTv1Qnt-wN7S1iG-M5iL-JybUz7DE41X_0A1byDl_a34dWuM7EyIGzQR2PhRQ-TCNQNuGLodY2nCmF4hz8vThOGVz3RAG_j6c3RkH-4T3ZxguaXpdWJL3ndpFLw5o-rke5z6FzqAJoLKpmI', members: 64, max: 100, bio: '日常接梗、世界观拼图与角色立绘互评。', requireApproval: false, state: 'joined' },
          { id: 'gj1', groupNo: '518024', name: '现代悬疑·宿敌脑洞屋', owner: '月见草', avatar: 'https://lh3.googleusercontent.com/aida/ALJJyrCypXxeUwWdNC7M6TW7CtAS_ch_477lXeguC2DCHOC9-DJsOleMr0Lmvex0-RWqW66yhmw7o2JM5LJsvBC4pm55PmKlGsGyHEGgAH_VP3ndzEvGRE9r58J-qwRd9_zgmdECbgFoI69vK6Jhhwrtt9_pNWcl7Xf_UGv0SpnyUn__XQrvhYNuaNnc8JUS1G2IH45AkOb_GvWaqFIeoTrwWbdA170c_sX7kiilIzMRe7qkKvJXIZ8NqoyE7WiHXU4', members: 46, max: 100, bio: '月见草粉丝与悬疑设定同好聚集地，不定期掉落免费剧本。', requireApproval: true, state: 'approval' },
          { id: 'gj2', groupNo: '740916', name: '星际休眠舱·世界观共创', owner: '南风知意', avatar: 'https://lh3.googleusercontent.com/aida/ALJJyrDzHZENl33wi65M9XLZKtqtzF3NascoRExBRgFEq9GjDD19ZK3sQAVHJu4YeXiWyqomWbIJt5bCJjTQ8iS4RzVk5I-Bm8jycGsXXmHhnCa_hVWAskymbI6xUfe5DnMV_e5ujvU3WqOBGB6SvdFjkltM28GzJ08c9obs309pT947f3ZSKc-gKeHjC4Li2eeUvRuBpa2OKV0E5NtQvtl9PJZsZI6l7TUTMIFmaAn5IS5Zt4ab2Wcer2PLMQ', members: 89, max: 100, bio: '科幻/星际题材设定共创与约稿进度播报。', requireApproval: false, state: 'direct' }
        ]
      };

      const GROUPS_KEY = 'daoyu_groups_v1';
      const searchToastEl = document.getElementById('gsearch-toast');
      let searchToastTimer = null;
      function showSearchToast(msg) {
        if (!searchToastEl) return;
        searchToastEl.textContent = msg;
        searchToastEl.classList.remove('hidden');
        clearTimeout(searchToastTimer);
        searchToastTimer = setTimeout(function () { searchToastEl.classList.add('hidden'); }, 1800);
      }

      function getSearchableGroups() {
        const merged = DATA.groups.map(function (g) { return Object.assign({}, g); });
        try {
          const raw = localStorage.getItem(GROUPS_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            const allLocal = [].concat(parsed.created || [], parsed.joined || []);
            allLocal.forEach(function (lg) {
              const gNo = lg.groupNo || '882019';
              const idx = merged.findIndex(function (m) { return m.id === lg.id || m.groupNo === gNo; });
              const item = {
                id: lg.id,
                groupNo: gNo,
                name: lg.name,
                owner: lg.owner || '零度写作',
                avatar: lg.avatar || 'https://lh3.googleusercontent.com/aida/ALJJyrBYUEfF61kgx9PKb6hooUymoQZLdIaOI7u_DG59J0_oogUyyqsYRAewYcsTXG-ii0tPxy4P7WPwOx6RcAl7-E-PMjNFsKcjQlsh9ZutlxoJEshDMrSNbZ1CePSAYGMtckwJfv1OdWapvQvC5-34GOMOeZ06l6jdVukh-k5cczMIYdBvb0ZZvFang9A8U7UpfWQ2B9DKzANrFSj8QQDTVAy6NTNVqlnReHX49F3WhPXbjH9Z-9WoVXflZMw6Q6U',
                members: lg.members || 1,
                max: lg.max || 100,
                bio: lg.bio || '',
                requireApproval: !!lg.requireApproval,
                state: 'joined'
              };
              if (idx !== -1) merged[idx] = item;
              else merged.unshift(item);
            });
          }
        } catch (e) {}
        return merged;
      }

      let activeScope = 'all';

      // ---------- 3. HTML 转义与关键词高亮工具 ----------
      function escapeHtml(str) {
        return str.replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function highlight(text, q) {
        const safe = escapeHtml(text);
        if (!q) return safe;
        const escapedQ = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return safe.replace(new RegExp('(' + escapedQ + ')', 'gi'), '<mark class="bg-light-secondary/20 text-light-on-surface font-semibold rounded px-0.5">$1</mark>');
      }

      // ---------- 4. 切换搜索分类范围 ----------
      function setScope(scope) {
        activeScope = SCOPE_NAMES[scope] ? scope : 'all';
        scopeTabs.forEach(function (tab) {
          const isActive = tab.getAttribute('data-scope') === activeScope;
          tab.classList.toggle('bg-light-primary', isActive);
          tab.classList.toggle('text-light-on-primary', isActive);
          tab.classList.toggle('bg-light-surface-container', !isActive);
          tab.classList.toggle('text-light-on-surface-variant', !isActive);
        });
        if (resultsScopeLabel) resultsScopeLabel.textContent = SCOPE_NAMES[activeScope];
        if (searchInput.value.trim()) {
          runSearch(searchInput.value.trim());
        }
      }

      function matchesQuery(fields, q) {
        const lower = q.toLowerCase();
        return fields.some(function (f) {
          return String(f || '').toLowerCase().indexOf(lower) !== -1;
        });
      }

      // ---------- 5. 执行搜索并按分类分组渲染结果 ----------
      function runSearch(query) {
        const q = query.trim();
        if (!q) {
          preSearchView.classList.remove('hidden');
          resultsView.classList.add('hidden');
          clearSearchBtn.classList.add('hidden');
          return;
        }

        preSearchView.classList.add('hidden');
        resultsView.classList.remove('hidden');
        clearSearchBtn.classList.remove('hidden');

        const scopesToShow = activeScope === 'all' ? ['groups', 'works', 'chats', 'creators', 'community'] : [activeScope];
        let total = 0;
        const sectionsHtml = [];

        if (scopesToShow.indexOf('groups') !== -1) {
          const allGroups = getSearchableGroups();
          const matchedGroups = allGroups.filter(function (g) {
            return matchesQuery([g.groupNo, g.name, g.owner, g.bio], q);
          });
          if (matchedGroups.length) {
            total += matchedGroups.length;
            sectionsHtml.push(
              '<section class="flex flex-col gap-2">' +
                '<div class="flex items-center justify-between">' +
                  '<h3 class="font-title text-title-md text-light-on-surface">群聊 / 群号</h3>' +
                  '<span class="font-label text-label-sm text-light-on-surface-variant">' + matchedGroups.length + ' 个</span>' +
                '</div>' +
                matchedGroups.map(function (g) {
                  let btnText = '加入群聊';
                  let btnCls = 'bg-light-primary text-light-on-primary';
                  if (g.state === 'joined') { btnText = '去聊天'; btnCls = 'bg-light-surface-container text-light-on-surface'; }
                  else if (g.state === 'approval') { btnText = '申请加入'; btnCls = 'bg-light-surface-container-high text-light-on-surface'; }
                  else if (g.state === 'pending') { btnText = '已申请'; btnCls = 'bg-light-surface-container text-light-on-surface-variant'; }
                  return (
                    '<div class="flex items-center gap-3 p-3 rounded-xl bg-light-surface-container-low border border-light-outline-variant/60">' +
                      '<img src="' + g.avatar + '" alt="' + escapeHtml(g.name) + '" class="w-12 h-12 rounded-xl object-cover shrink-0 ring-1 ring-light-outline-variant/60">' +
                      '<div class="flex-1 min-w-0 flex flex-col gap-0.5">' +
                        '<div class="flex items-center gap-1.5 min-w-0">' +
                          '<span class="font-title text-body-md font-semibold text-light-on-surface truncate">' + highlight(g.name, q) + '</span>' +
                          '<span class="font-mono text-label-sm text-light-on-surface-variant shrink-0 tabular-nums">(' + g.members + ')</span>' +
                        '</div>' +
                        '<div class="flex items-center gap-1.5">' +
                          '<span class="font-mono text-[11px] text-light-primary font-medium tabular-nums">群号 ' + highlight(g.groupNo, q) + '</span>' +
                          '<span class="font-body text-[11px] text-light-on-surface-variant truncate">· 群主 ' + escapeHtml(g.owner) + '</span>' +
                        '</div>' +
                        '<p class="font-body text-body-sm text-light-on-surface-variant truncate">' + highlight(g.bio, q) + '</p>' +
                      '</div>' +
                      '<button type="button" data-join-gno="' + g.groupNo + '" class="gs-join-group-btn px-3 py-1.5 rounded-full font-label text-label-sm shrink-0 active:scale-95 transition-all ' + btnCls + '">' + btnText + '</button>' +
                    '</div>'
                  );
                }).join('') +
              '</section>'
            );
          }
        }

        if (scopesToShow.indexOf('works') !== -1) {
          const matchedWorks = DATA.works.filter(function (w) {
            return matchesQuery([w.title, w.desc, w.author, w.tags.join(' ')], q);
          });
          if (matchedWorks.length) {
            total += matchedWorks.length;
            sectionsHtml.push(
              '<section class="flex flex-col gap-2">' +
                '<div class="flex items-center justify-between">' +
                  '<h3 class="font-title text-title-md text-light-on-surface">作品与设定</h3>' +
                  '<span class="font-label text-label-sm text-light-on-surface-variant">' + matchedWorks.length + ' 条</span>' +
                '</div>' +
                matchedWorks.map(function (w) {
                  return (
                    '<a href="' + w.href + '" class="flex gap-3 p-2.5 rounded-xl bg-light-surface-container-low border border-light-outline-variant/60 hover:bg-light-surface-container transition-colors">' +
                      '<img src="' + w.img + '" alt="' + escapeHtml(w.title) + '" class="w-16 h-20 rounded-lg object-cover shrink-0">' +
                      '<div class="flex-1 min-w-0 flex flex-col justify-between">' +
                        '<div>' +
                          '<h4 class="font-title text-body-md font-semibold text-light-on-surface truncate">' + highlight(w.title, q) + '</h4>' +
                          '<p class="font-body text-body-sm text-light-on-surface-variant line-clamp-2 mt-0.5">' + highlight(w.desc, q) + '</p>' +
                        '</div>' +
                        '<div class="flex items-center justify-between text-label-sm text-light-on-surface-variant mt-1">' +
                          '<span>' + highlight(w.author, q) + '</span>' +
                          '<span>赞 ' + w.likes + '</span>' +
                        '</div>' +
                      '</div>' +
                    '</a>'
                  );
                }).join('') +
              '</section>'
            );
          }
        }

        if (scopesToShow.indexOf('chats') !== -1) {
          const matchedChats = DATA.chats.filter(function (c) {
            return matchesQuery([c.target, c.kind, c.snippet], q);
          });
          if (matchedChats.length) {
            total += matchedChats.length;
            sectionsHtml.push(
              '<section class="flex flex-col gap-2">' +
                '<div class="flex items-center justify-between">' +
                  '<h3 class="font-title text-title-md text-light-on-surface">聊天记录</h3>' +
                  '<span class="font-label text-label-sm text-light-on-surface-variant">' + matchedChats.length + ' 条</span>' +
                '</div>' +
                matchedChats.map(function (c) {
                  const av = c.avatar
                    ? '<img src="' + c.avatar + '" alt="' + escapeHtml(c.target) + '" class="w-10 h-10 rounded-full object-cover shrink-0">'
                    : '<span class="w-10 h-10 rounded-full bg-light-surface-container-high text-light-on-surface font-label text-label-lg flex items-center justify-center shrink-0">' + escapeHtml(c.initial || '聊') + '</span>';
                  return (
                    '<a href="' + c.href + '" class="flex items-start gap-3 p-3 rounded-xl bg-light-surface-container-low border border-light-outline-variant/60 hover:bg-light-surface-container transition-colors">' +
                      av +
                      '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center justify-between gap-2">' +
                          '<span class="font-title text-body-md font-semibold text-light-on-surface truncate">' + highlight(c.target, q) + '</span>' +
                          '<span class="font-label text-label-sm text-light-on-surface-variant shrink-0">' + c.time + '</span>' +
                        '</div>' +
                        '<span class="inline-block mt-0.5 px-1.5 py-0.5 rounded bg-light-surface-container text-light-on-surface-variant font-label text-[10px]">' + c.kind + '</span>' +
                        '<p class="font-body text-body-sm text-light-on-surface-variant line-clamp-2 mt-1">' + highlight(c.snippet, q) + '</p>' +
                      '</div>' +
                    '</a>'
                  );
                }).join('') +
              '</section>'
            );
          }
        }

        if (scopesToShow.indexOf('creators') !== -1) {
          const matchedCreators = DATA.creators.filter(function (u) {
            return matchesQuery([u.name, u.badge, u.bio], q);
          });
          if (matchedCreators.length) {
            total += matchedCreators.length;
            sectionsHtml.push(
              '<section class="flex flex-col gap-2">' +
                '<div class="flex items-center justify-between">' +
                  '<h3 class="font-title text-title-md text-light-on-surface">创作者</h3>' +
                  '<span class="font-label text-label-sm text-light-on-surface-variant">' + matchedCreators.length + ' 位</span>' +
                '</div>' +
                matchedCreators.map(function (u) {
                  const av = u.avatar
                    ? '<img src="' + u.avatar + '" alt="' + escapeHtml(u.name) + '" class="w-11 h-11 rounded-full object-cover shrink-0">'
                    : '<span class="w-11 h-11 rounded-full bg-light-surface-container-high text-light-on-surface font-label text-label-lg flex items-center justify-center shrink-0">' + escapeHtml(u.initial || '创') + '</span>';
                  return (
                    '<a href="' + u.href + '" class="flex items-center gap-3 p-3 rounded-xl bg-light-surface-container-low border border-light-outline-variant/60 hover:bg-light-surface-container transition-colors">' +
                      av +
                      '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-1.5">' +
                          '<span class="font-title text-body-md font-semibold text-light-on-surface truncate">' + highlight(u.name, q) + '</span>' +
                          '<span class="px-1.5 py-0.5 rounded-full bg-light-secondary/15 text-light-secondary font-label text-[10px] shrink-0">' + u.badge + '</span>' +
                        '</div>' +
                        '<p class="font-body text-body-sm text-light-on-surface-variant truncate mt-0.5">' + highlight(u.bio, q) + '</p>' +
                        '<span class="font-label text-label-sm text-light-on-surface-variant">' + u.followers + '</span>' +
                      '</div>' +
                    '</a>'
                  );
                }).join('') +
              '</section>'
            );
          }
        }

        if (scopesToShow.indexOf('community') !== -1) {
          const matchedPosts = DATA.community.filter(function (p) {
            return matchesQuery([p.author, p.text, p.tags.join(' ')], q);
          });
          if (matchedPosts.length) {
            total += matchedPosts.length;
            sectionsHtml.push(
              '<section class="flex flex-col gap-2">' +
                '<div class="flex items-center justify-between">' +
                  '<h3 class="font-title text-title-md text-light-on-surface">社区动态</h3>' +
                  '<span class="font-label text-label-sm text-light-on-surface-variant">' + matchedPosts.length + ' 条</span>' +
                '</div>' +
                matchedPosts.map(function (p) {
                  return (
                    '<a href="' + p.href + '" class="flex flex-col gap-1.5 p-3 rounded-xl bg-light-surface-container-low border border-light-outline-variant/60 hover:bg-light-surface-container transition-colors">' +
                      '<div class="flex items-center justify-between text-label-sm text-light-on-surface-variant">' +
                        '<span class="font-medium text-light-on-surface">' + highlight(p.author, q) + '</span>' +
                        '<span>' + p.time + '</span>' +
                      '</div>' +
                      '<p class="font-body text-body-sm text-light-on-surface leading-relaxed">' + highlight(p.text, q) + '</p>' +
                      '<div class="flex items-center justify-between text-label-sm text-light-on-surface-variant">' +
                        '<span>' + p.tags.join(' ') + '</span>' +
                        '<span>赞 ' + p.likes + '</span>' +
                      '</div>' +
                    '</a>'
                  );
                }).join('') +
              '</section>'
            );
          }
        }

        resultsCountText.textContent = '找到 ' + total + ' 条相关结果';
        resultsContainer.innerHTML = sectionsHtml.join('');
        resultsContainer.querySelectorAll('.gs-join-group-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const gNo = btn.getAttribute('data-join-gno');
            const allGroups = getSearchableGroups();
            const target = allGroups.find(function (item) { return item.groupNo === gNo; });
            if (!target) return;
            if (target.state === 'joined') {
              window.location.href = '../68-group-chat/GroupChat.html?gid=' + encodeURIComponent(target.id);
              return;
            }
            if (target.state === 'pending') {
              showSearchToast('已提交入群申请，请等待群主审批');
              return;
            }
            if (target.state === 'approval') {
              const base = DATA.groups.find(function (item) { return item.groupNo === gNo; });
              if (base) base.state = 'pending';
              showSearchToast('已申请加入「' + target.name + '」');
              runSearch(searchInput.value);
              return;
            }
            const base = DATA.groups.find(function (item) { return item.groupNo === gNo; });
            if (base) base.state = 'joined';
            try {
              const raw = localStorage.getItem(GROUPS_KEY);
              const store = raw ? JSON.parse(raw) : { created: [], joined: [] };
              store.joined = store.joined || [];
              if (!store.joined.some(function (j) { return j.groupNo === gNo; })) {
                store.joined.unshift({
                  id: target.id,
                  groupNo: target.groupNo,
                  owner: target.owner,
                  name: target.name,
                  avatar: target.avatar,
                  members: target.members + 1,
                  max: target.max || 100,
                  bio: target.bio,
                  requireApproval: false
                });
                localStorage.setItem(GROUPS_KEY, JSON.stringify(store));
              }
            } catch (e) {}
            showSearchToast('已加入「' + target.name + '」');
            runSearch(searchInput.value);
          });
        });
        resultsEmpty.classList.toggle('hidden', total > 0);
      }

      // ---------- 6. 绑定返回、Tab 切换、输入及热词点击事件 ----------
      if (backBtn) {
        backBtn.addEventListener('click', function () {
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = '../06-home-feed/HomeFeed.html';
          }
        });
      }

      scopeTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          setScope(tab.getAttribute('data-scope'));
        });
      });

      searchInput.addEventListener('input', function () {
        runSearch(searchInput.value);
      });

      searchForm.addEventListener('submit', function (e) {
        e.preventDefault();
        runSearch(searchInput.value);
      });

      clearSearchBtn.addEventListener('click', function () {
        searchInput.value = '';
        runSearch('');
        searchInput.focus();
      });

      if (clearHistoryBtn && recentSection) {
        clearHistoryBtn.addEventListener('click', function () {
          if (recentChips) recentChips.innerHTML = '';
          recentSection.classList.add('hidden');
        });
      }

      document.querySelectorAll('.quick-term').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const term = btn.getAttribute('data-term') || btn.textContent.trim();
          searchInput.value = term;
          runSearch(term);
        });
      });

      // ---------- 7. 读取 URL 参数 (?scope= & ?q=) 自动初始化搜索 ----------
      try {
        const params = new URLSearchParams(window.location.search);
        const initScope = params.get('scope');
        const initQ = params.get('q');
        if (initScope && SCOPE_NAMES[initScope]) {
          setScope(initScope);
        }
        if (initQ) {
          searchInput.value = initQ;
          runSearch(initQ);
        }
      } catch (e) {}
    })();
  </script>


