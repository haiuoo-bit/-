  <script>
    (function () {
      // ---------- 1. 轮播图自动切换与圆点控制 ----------
      const track = document.getElementById('carousel-track');
      const dots = Array.from(document.querySelectorAll('.carousel-dot'));
      let currentSlide = 0;
      const totalSlides = dots.length;
      let slideTimer = null;

      function goToSlide(index) {
        currentSlide = (index + totalSlides) % totalSlides;
        if (track) track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
        dots.forEach(function (dot, i) {
          const active = i === currentSlide;
          dot.classList.toggle('w-4', active);
          dot.classList.toggle('w-1.5', !active);
          dot.classList.toggle('bg-dark-on-surface', active);
          dot.classList.toggle('bg-dark-on-surface/50', !active);
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goToSlide(parseInt(dot.getAttribute('data-slide'), 10) || 0);
          resetCarouselTimer();
        });
      });

      function resetCarouselTimer() {
        if (slideTimer) clearInterval(slideTimer);
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          slideTimer = setInterval(function () {
            goToSlide(currentSlide + 1);
          }, 4200);
        }
      }
      resetCarouselTimer();

      // ---------- 2. 筛选状态（搜索 + 玩法 + 标签）与列表联动 ----------
      let activeKind = '全部';
      let activeTag = '全部';
      let searchQuery = '';

      const searchInput = document.getElementById('plaza-search');
      const cards = Array.from(document.querySelectorAll('.plaza-card'));
      const latestSection = document.getElementById('latest-works-section');
      const latestCards = Array.from(document.querySelectorAll('.latest-work-card'));
      const emptyState = document.getElementById('plaza-empty');
      const activeBadge = document.getElementById('active-filter-badge');
      const resetBtn = document.getElementById('reset-filter-btn');
      const emptyResetBtn = document.getElementById('empty-reset-btn');
      const tagChips = Array.from(document.querySelectorAll('.tag-chip'));
      const kindShortcuts = Array.from(document.querySelectorAll('.kind-shortcut'));

      function applyFilters() {
        let visibleCount = 0;
        let visibleLatest = 0;
        const q = searchQuery.trim().toLowerCase();

        // 过滤最新作品卡片（仅在玩法为「全部」时展示）
        latestCards.forEach(function (card) {
          const t = card.getAttribute('data-tag');
          const text = card.textContent.toLowerCase();
          const matchTag = activeTag === '全部' || t === activeTag;
          const matchSearch = !q || text.indexOf(q) !== -1;
          const show = activeKind === '全部' && matchTag && matchSearch;
          card.classList.toggle('hidden', !show);
          if (show) visibleLatest += 1;
        });

        if (latestSection) {
          latestSection.classList.toggle('hidden', visibleLatest === 0);
        }

        // 过滤广场活动卡片
        cards.forEach(function (card) {
          const k = card.getAttribute('data-kind');
          const t = card.getAttribute('data-tag');
          const text = card.textContent.toLowerCase();
          const matchKind = activeKind === '全部' || k === activeKind;
          const matchTag = activeTag === '全部' || t === activeTag;
          const matchSearch = !q || text.indexOf(q) !== -1;
          const show = matchKind && matchTag && matchSearch;
          card.classList.toggle('hidden', !show);
          if (show) visibleCount += 1;
        });

        // 同步空状态与重置按钮显隐
        emptyState.classList.toggle('hidden', visibleCount + visibleLatest > 0);

        const hasFilter = activeKind !== '全部' || activeTag !== '全部' || q.length > 0;
        resetBtn.classList.toggle('hidden', !hasFilter);
        if (activeKind !== '全部') {
          activeBadge.textContent = activeKind;
          activeBadge.classList.remove('hidden');
        } else {
          activeBadge.classList.add('hidden');
        }

        // 同步顶部标签胶囊激活态
        tagChips.forEach(function (chip) {
          const active = chip.getAttribute('data-tag') === activeTag;
          chip.classList.toggle('bg-light-primary', active);
          chip.classList.toggle('text-light-on-primary', active);
          chip.classList.toggle('bg-light-surface-container', !active);
          chip.classList.toggle('text-light-on-surface-variant', !active);
        });

        renderSheetActivities();
      }

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          searchQuery = searchInput.value;
          applyFilters();
        });
      }

      tagChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeTag = chip.getAttribute('data-tag');
          applyFilters();
        });
      });

      kindShortcuts.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const k = btn.getAttribute('data-kind');
          activeKind = activeKind === k ? '全部' : k;
          applyFilters();
        });
      });

      function resetAllFilters() {
        activeKind = '全部';
        activeTag = '全部';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        applyFilters();
      }
      if (resetBtn) resetBtn.addEventListener('click', resetAllFilters);
      if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAllFilters);

      // ---------- 3. 分类抽屉弹窗渲染与开关 ----------
      const categoryDrawer = document.getElementById('category-drawer');
      const openCategoryBtn = document.getElementById('open-category-btn');
      const closeCategoryBtn = document.getElementById('close-category-btn');
      const categoryBackdrop = document.getElementById('category-backdrop');
      const sheetKindBtns = Array.from(document.querySelectorAll('.sheet-kind-btn'));
      const sheetTagBtns = Array.from(document.querySelectorAll('.sheet-tag-btn'));
      const sheetList = document.getElementById('sheet-activity-list');
      const sheetCount = document.getElementById('sheet-count');

      function renderSheetActivities() {
        if (!sheetList) return;
        sheetList.innerHTML = '';
        let count = 0;

        cards.forEach(function (card) {
          const k = card.getAttribute('data-kind');
          const t = card.getAttribute('data-tag');
          const matchKind = activeKind === '全部' || k === activeKind;
          const matchTag = activeTag === '全部' || t === activeTag;
          if (!matchKind || !matchTag) return;
          count += 1;

          const titleEl = card.querySelector('h4');
          const descEl = card.querySelector('p');
          const row = document.createElement('div');
          row.className = 'p-gutter-md rounded-md bg-light-surface-container-low border border-light-outline-variant flex items-center justify-between gap-gutter-sm';
          row.innerHTML =
            '<div class="min-w-0 flex-1">' +
              '<div class="flex items-center gap-1.5 mb-0.5">' +
                '<span class="px-1.5 py-0.5 rounded-sm bg-light-surface-container font-label text-label-sm text-light-on-surface">' + k + '</span>' +
                '<span class="font-label text-label-sm text-light-on-surface-variant">#' + t + '</span>' +
              '</div>' +
              '<p class="font-title text-title-md text-light-on-surface truncate"></p>' +
              '<p class="font-body text-body-sm text-light-on-surface-variant truncate"></p>' +
            '</div>' +
            '<span class="shrink-0 font-label text-label-sm text-light-secondary">查看</span>';
          row.querySelector('p.font-title').textContent = titleEl ? titleEl.textContent : '';
          row.querySelector('p.font-body').textContent = descEl ? descEl.textContent : '';
          row.addEventListener('click', function () {
            categoryDrawer.classList.add('hidden');
            showToast('已定位活动：' + (titleEl ? titleEl.textContent : k));
          });
          sheetList.appendChild(row);
        });

        if (sheetCount) sheetCount.textContent = count + ' 项';

        // 同步抽屉内玩法与标签按钮激活态
        sheetKindBtns.forEach(function (btn) {
          const active = btn.getAttribute('data-sheet-kind') === activeKind;
          btn.classList.toggle('bg-light-primary', active);
          btn.classList.toggle('text-light-on-primary', active);
          btn.classList.toggle('bg-light-surface-container', !active);
          btn.classList.toggle('text-light-on-surface-variant', !active);
        });
        sheetTagBtns.forEach(function (btn) {
          const active = btn.getAttribute('data-sheet-tag') === activeTag;
          btn.classList.toggle('bg-light-primary', active);
          btn.classList.toggle('text-light-on-primary', active);
          btn.classList.toggle('bg-light-surface-container', !active);
          btn.classList.toggle('text-light-on-surface-variant', !active);
        });
      }

      sheetKindBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeKind = btn.getAttribute('data-sheet-kind');
          applyFilters();
        });
      });
      sheetTagBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeTag = btn.getAttribute('data-sheet-tag');
          applyFilters();
        });
      });

      function openCategoryDrawer() {
        renderSheetActivities();
        categoryDrawer.classList.remove('hidden');
      }
      function closeCategoryDrawer() {
        categoryDrawer.classList.add('hidden');
      }
      if (openCategoryBtn) openCategoryBtn.addEventListener('click', openCategoryDrawer);
      if (closeCategoryBtn) closeCategoryBtn.addEventListener('click', closeCategoryDrawer);
      if (categoryBackdrop) categoryBackdrop.addEventListener('click', closeCategoryDrawer);

      // ---------- 4. 创作公示台弹窗开关 ----------
      const noticeModal = document.getElementById('notice-modal');
      const openNoticeBtn = document.getElementById('open-notice-btn');
      const closeNoticeBtn = document.getElementById('close-notice-btn');
      const confirmNoticeBtn = document.getElementById('confirm-notice-btn');
      const noticeBackdrop = document.getElementById('notice-backdrop');

      function openNoticeModal() { noticeModal.classList.remove('hidden'); }
      function closeNoticeModal() { noticeModal.classList.add('hidden'); }
      if (openNoticeBtn) openNoticeBtn.addEventListener('click', openNoticeModal);
      if (closeNoticeBtn) closeNoticeBtn.addEventListener('click', closeNoticeModal);
      if (confirmNoticeBtn) confirmNoticeBtn.addEventListener('click', closeNoticeModal);
      if (noticeBackdrop) noticeBackdrop.addEventListener('click', closeNoticeModal);

      // ---------- 5. 活动按钮轻提示反馈 ----------
      const toastEl = document.getElementById('plaza-toast');
      let toastTimer = null;
      function showToast(msg) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.remove('hidden');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toastEl.classList.add('hidden');
        }, 1600);
      }

      document.querySelectorAll('.join-activity-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const card = btn.closest('.plaza-card');
          const title = card && card.querySelector('h4') ? card.querySelector('h4').textContent : '广场活动';
          showToast('已打开：' + title);
        });
      });

      renderSheetActivities();

      // ---------- 6. 下拉刷新动效 ----------
      function initPullToRefresh(scrollEl, onRefresh) {
        if (!scrollEl || scrollEl.dataset.ptrBound) return;
        scrollEl.dataset.ptrBound = '1';
        const indicator = document.createElement('div');
        indicator.className = 'ptr-indicator flex items-center justify-center gap-1.5 overflow-hidden text-light-on-surface-variant font-label text-label-sm transition-all duration-200 select-none';
        indicator.style.height = '0px';
        indicator.style.opacity = '0';
        indicator.innerHTML = '<svg class="ptr-spinner w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none"><path d="M12 4V7M12 17V20M4 12H7M17 12H20M6.34 6.34L8.46 8.46M15.54 15.54L17.66 17.66M6.34 17.66L8.46 15.54M15.54 8.46L17.66 6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span class="ptr-label">下拉刷新</span>';
        scrollEl.insertBefore(indicator, scrollEl.firstChild);
        const spinner = indicator.querySelector('.ptr-spinner');
        const label = indicator.querySelector('.ptr-label');
        let startY = 0; let pulling = false; let refreshing = false;
        const THRESHOLD = 56;
        function startPull(y) { if (refreshing || scrollEl.scrollTop > 0) return; startY = y; pulling = true; indicator.style.transition = 'none'; }
        function movePull(y) {
          if (!pulling || refreshing) return;
          const dy = y - startY;
          if (dy <= 0) { indicator.style.height = '0px'; indicator.style.opacity = '0'; return; }
          const dist = Math.min(84, dy * 0.48);
          indicator.style.height = dist + 'px';
          indicator.style.opacity = String(Math.min(1, dist / 40));
          if (spinner) spinner.style.transform = 'rotate(' + (dist * 4) + 'deg)';
          if (label) label.textContent = dist >= THRESHOLD ? '释放立即刷新' : '下拉刷新';
        }
        function endPull() {
          if (!pulling || refreshing) return;
          pulling = false;
          indicator.style.transition = 'all 200ms cubic-bezier(0.22, 1, 0.36, 1)';
          const h = parseFloat(indicator.style.height) || 0;
          if (h >= THRESHOLD) {
            refreshing = true;
            indicator.style.height = '44px';
            indicator.style.opacity = '1';
            if (spinner) spinner.classList.add('animate-spin');
            if (label) label.textContent = '正在刷新...';
            setTimeout(function () {
              if (spinner) spinner.classList.remove('animate-spin');
              indicator.style.height = '0px';
              indicator.style.opacity = '0';
              refreshing = false;
              if (onRefresh) onRefresh();
            }, 650);
          } else {
            indicator.style.height = '0px';
            indicator.style.opacity = '0';
          }
        }
