        <!-- [章节 4] 剧本设定文档（报名后解锁下载设定文档与上传通关截图） -->
        <section id="task-hub-card" class="p-gutter-md rounded-md bg-light-surface-container-low border border-light-outline-variant flex flex-col gap-gutter-sm">
          <div class="flex items-center justify-between gap-2">
