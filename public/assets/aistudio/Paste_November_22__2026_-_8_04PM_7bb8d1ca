        var clamped = Math.max(1, Math.min(100, pct));
        ringProgress.style.strokeDashoffset = (CIRCUMFERENCE * (1 - clamped / 100)).toFixed(2);
        bar.style.width = clamped + '%';
        percentText.textContent = clamped + '%';
        pillText.textContent = '更新包下载中 ' + clamped + '%';
        if (sizeLabel) {
          sizeLabel.textContent = (48.6 * clamped / 100).toFixed(1) + ' / 48.6 MB';
        }

        // 未满 100% 时显示「后台下载」次按钮；满 100% 后切换为「立即安装」主按钮
        if (clamped < 100) {
          isDownloadDone = false;
          ringIcon.textContent = 'arrow_downward';
          statusText.textContent = '正在下载更新包...';
          btnBackground.className = 'w-full h-11 px-gutter-xl rounded-full bg-light-surface-container text-light-on-surface flex items-center justify-center transition-transform duration-state-change ease-state-change active:scale-[0.98] hover:bg-light-surface-container-high focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary';
          btnBackground.querySelector('span').textContent = '后台下载';
        } else {
          isDownloadDone = true;
          ringIcon.textContent = 'check';
          statusText.textContent = '下载完成，已就绪';
          btnBackground.className = 'w-full h-11 px-gutter-xl rounded-full bg-light-primary text-light-on-primary flex items-center justify-center transition-transform duration-state-change ease-state-change active:scale-[0.98] shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary';
          btnBackground.querySelector('span').textContent = '立即安装';
        }
      }

      // 点击进度条区域可演示 1% → 100% 自动下载完成流程
      progressTrigger.addEventListener('click', function () {
        if (timer) clearInterval(timer);
        var pct = 1;
        renderProgress(pct);
        timer = setInterval(function () {
          pct += 4;
          if (pct >= 100) {
            pct = 100;
            clearInterval(timer);
            renderProgress(100);
            showToast('下载完成，可点击立即安装');
          } else {
            renderProgress(pct);
          }
        }, 90);
      });

      // ---------- 4. 弹窗收起至后台胶囊 & 重新唤起 ----------
      function dismissToBackground() {
        if (modalUpdate && typeof modalUpdate.close === 'function') {
          modalUpdate.close();
        }
        bgPill.classList.remove('hidden');
        showToast('已切换至后台继续下载');
      }

      // 底部按钮根据下载状态执行「拉起安装」或「切换后台」
      btnBackground.addEventListener('click', function () {
        if (isDownloadDone) {
          showToast('正在拉起系统安装界面...');
        } else {
          dismissToBackground();
        }
      });
      if (btnCloseX) {
        btnCloseX.addEventListener('click', dismissToBackground);
      }

      // 点击后台胶囊重新打开更新弹窗
      btnReopen.addEventListener('click', function () {
        bgPill.classList.add('hidden');
        if (modalUpdate && typeof modalUpdate.showModal === 'function') {
          modalUpdate.showModal();
        }
      });
    })();
  </script>


