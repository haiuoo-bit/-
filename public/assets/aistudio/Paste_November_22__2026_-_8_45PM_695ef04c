  <script>
    (function () {
      // ---------- 1. DOM 引用 ----------
      const searchInput = document.getElementById('msg-search');
      const dmRows = Array.from(document.querySelectorAll('.dm-row'));
      const sectionTitle = document.getElementById('dm-section-title');
      const resetBtn = document.getElementById('dm-filter-reset');

      // ---------- 2. 本地关键词过滤（兼容内联搜索框） ----------
      if (searchInput) {
        searchInput.addEventListener('input', function () {
          const q = searchInput.value.trim().toLowerCase();
          dmRows.forEach(function (row) {
            const text = row.textContent.toLowerCase();
            row.classList.toggle('hidden', q && text.indexOf(q) === -1);
          });
        });
      }

      // ---------- 3. 四大通知分类切换与恢复全部 ----------
      document.querySelectorAll('.msg-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const cat = btn.getAttribute('data-cat');
          if (sectionTitle) sectionTitle.textContent = cat;
          if (resetBtn) resetBtn.classList.remove('hidden');
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          if (sectionTitle) sectionTitle.textContent = '私信与群聊';
          resetBtn.classList.add('hidden');
        });
      }

      // ---------- 4. 联动 68 群聊最新消息预览 ----------
      try {
        const lastMsgMap = JSON.parse(localStorage.getItem('daoyu_group_last_msg_v1') || '{}');
        document.querySelectorAll('.group-msg-row').forEach(function (row) {
          const gid = row.getAttribute('data-gid');
          if (gid && lastMsgMap[gid]) {
            const previewEl = row.querySelector('.group-msg-preview');
            const timeEl = row.querySelector('.group-msg-time');
            if (previewEl && lastMsgMap[gid].text) previewEl.textContent = lastMsgMap[gid].text;
            if (timeEl && lastMsgMap[gid].time) timeEl.textContent = lastMsgMap[gid].time;
          }
        });
      } catch (e) {}

      // ---------- 5. 下拉刷新动效 ----------
      function initPullToRefresh(scrollEl, onRefresh) {
        if (!scrollEl || scrollEl.dataset.ptrBound) return;
        scrollEl.dataset.ptrBound = '1';
        const indicator = document.createElement('div');
        indicator.className = 'ptr-indicator flex items-center justify-center gap-1.5 overflow-hidden text-light-on-surface-variant font-label text-label-sm transition-all duration-200 select-none';
