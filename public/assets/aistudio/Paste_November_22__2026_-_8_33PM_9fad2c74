  <script data-stitch-original-script="527f1f2ebb6355e3===../../images/avatar_me_user.jpg">
    (function () {
      // ---------- 1. 全局轻提示与商品分类横向滑动筛选 ----------
      const toastEl = document.getElementById('market-toast');
      let toastTimer = null;
      function showToast(msg) {
        toastEl.textContent = msg;
        toastEl.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 2200);
      }

      const filterTabs = document.getElementById('market-filter-tabs');
      const catBtns = document.querySelectorAll('.market-cat-btn');
      const marketList = document.getElementById('market-list');

      function filterCards(cat) {
        catBtns.forEach((b) => {
          const active = b.dataset.cat === cat;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.className = active
            ? 'market-cat-btn shrink-0 px-3 py-1.5 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm transition-colors duration-state-change'
            : 'market-cat-btn shrink-0 px-3 py-1.5 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm hover:bg-light-surface-container-high transition-colors duration-state-change';
          if (active && b.scrollIntoView) {
            b.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: 'smooth' });
          }
        });
        marketList.querySelectorAll('.market-card').forEach((card) => {
          const match = cat === 'all' || card.dataset.category === cat;
          card.classList.toggle('hidden', !match);
        });
      }

      let hasDragged = false;
      catBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (hasDragged) {
            e.preventDefault();
            return;
          }
          filterCards(btn.dataset.cat);
        });
      });

      // 支持桌面端滚轮、触控与任意位置拖拽横向滑动分类栏
      if (filterTabs) {
        filterTabs.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            filterTabs.scrollLeft += e.deltaY;
            e.preventDefault();
          }
        }, { passive: false });

        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        filterTabs.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') return;
          isDown = true;
          hasDragged = false;
          startX = e.pageX - filterTabs.offsetLeft;
          scrollLeft = filterTabs.scrollLeft;
        });
        window.addEventListener('pointerup', () => {
          isDown = false;
          setTimeout(() => { hasDragged = false; }, 0);
        });
        filterTabs.addEventListener('pointermove', (e) => {
          if (!isDown) return;
          const x = e.pageX - filterTabs.offsetLeft;
          const dx = x - startX;
          if (Math.abs(dx) > 5) hasDragged = true;
          if (hasDragged) {
            e.preventDefault();
            filterTabs.scrollLeft = scrollLeft - dx;
          }
        });
      }

      // 点击商品卡片空白/标题区域跳转至 70 商品详情二级页面
      marketList.querySelectorAll('.market-card').forEach((card) => {
        card.classList.add('cursor-pointer', 'hover:border-light-outline', 'transition-colors', 'duration-state-change');
        card.addEventListener('click', (e) => {
          if (e.target.closest('button, a')) return;
          const itemId = card.dataset.id || 'doc-no-ooc';
          window.location.href = '../70-market-item-detail/MarketItemDetail.html?id=' + encodeURIComponent(itemId);
        });
      });

      // ---------- 2. 购买确认弹窗、支付解锁与下载进度 ----------
      const buySheet = document.getElementById('buy-sheet');
      const buySheetTitle = document.getElementById('buy-sheet-title');
      const buyStepConfirm = document.getElementById('buy-step-confirm');
      const buyStepLoading = document.getElementById('buy-step-loading');
      const buyStepSuccess = document.getElementById('buy-step-success');
      const buyItemName = document.getElementById('buy-item-name');
      const buyItemMeta = document.getElementById('buy-item-meta');
      const buyItemPrice = document.getElementById('buy-item-price');
      const buySuccessName = document.getElementById('buy-success-name');
      const confirmBuyBtn = document.getElementById('confirm-buy-btn');
      const buyDownloadBtn = document.getElementById('buy-download-btn');
      const buyOpenPreviewBtn = document.getElementById('buy-open-preview-btn');
      const buyDlBox = document.getElementById('buy-download-progress');
      const buyDlStatus = document.getElementById('buy-download-status');
      const buyDlPct = document.getElementById('buy-download-pct');
      const buyDlBar = document.getElementById('buy-download-bar');

      const previewSheet = document.getElementById('preview-sheet');
      const previewTitle = document.getElementById('preview-sheet-title');
      const previewContent = document.getElementById('preview-content');
      const previewDownloadBtn = document.getElementById('preview-download-btn');
      const previewDlBox = document.getElementById('preview-download-progress');
      const previewDlStatus = document.getElementById('preview-download-status');
      const previewDlPct = document.getElementById('preview-download-pct');
      const previewDlBar = document.getElementById('preview-download-bar');

      let activeCard = null;
      let buyTimer = null;
      let dlTimer = null;

      function resetBuySheet() {
        clearTimeout(buyTimer);
        clearInterval(dlTimer);
        buySheetTitle.textContent = '确认购买';
        buyStepConfirm.classList.remove('hidden');
        buyStepLoading.classList.add('hidden');
        buyStepSuccess.classList.add('hidden');
        buyDlBox.classList.add('hidden');
        buyDlBar.style.width = '0%';
        buyDlPct.textContent = '0%';
        buyDownloadBtn.disabled = false;
        buyDownloadBtn.textContent = '下载到本地';
      }

      // 通用文档打包下载进度模拟
      function runDownloadProgress(box, statusEl, pctEl, barEl, btnEl) {
        clearInterval(dlTimer);
        box.classList.remove('hidden');
        btnEl.disabled = true;
        btnEl.textContent = '正在下载…';
        statusEl.textContent = '正在打包并下载文档…';
        let pct = 0;
        barEl.style.width = '0%';
        pctEl.textContent = '0%';
        dlTimer = setInterval(() => {
          pct += Math.floor(Math.random() * 18) + 14;
          if (pct >= 100) {
            pct = 100;
            clearInterval(dlTimer);
            barEl.style.width = '100%';
            pctEl.textContent = '100%';
            statusEl.textContent = '下载完成，已保存至本地';
            btnEl.disabled = false;
            btnEl.textContent = '重新下载';
            showToast('文档已下载到本地');
            return;
          }
          barEl.style.width = pct + '%';
          pctEl.textContent = pct + '%';
        }, 140);
      }

      // 为商品卡片绑定购买或已购预览事件
      function isPluginCard(card) {
        return card && (card.dataset.type === 'plugin' || card.dataset.category === 'plugins');
      }

      function bindCardBuy(card) {
        const btn = card.querySelector('.buy-btn');
        btn.addEventListener('click', () => {
          activeCard = card;
          const isPlugin = isPluginCard(card);
          if (card.dataset.purchased === 'true') {
            previewTitle.textContent = isPlugin ? '插件安装说明' : card.dataset.title;
            previewContent.textContent = card.dataset.preview || '已解锁完整内容，可直接复制使用。';
            previewDlBox.classList.add('hidden');
            previewDlBar.style.width = '0%';
            previewDownloadBtn.disabled = false;
            previewDownloadBtn.textContent = isPlugin ? '下载插件包' : '下载到本地';
            previewSheet.classList.remove('hidden');
            return;
          }
          resetBuySheet();
          buyItemName.textContent = card.dataset.title;
          buyItemMeta.textContent = card.dataset.seller + ' · ' + card.dataset.format;
          buyItemPrice.textContent = '￥' + card.dataset.price;
          buySheet.classList.remove('hidden');
        });
      }

      marketList.querySelectorAll('.market-card').forEach(bindCardBuy);

      function closeBuy() {
        clearTimeout(buyTimer);
        clearInterval(dlTimer);
        buySheet.classList.add('hidden');
      }
      document.getElementById('buy-sheet-backdrop').addEventListener('click', closeBuy);
      document.getElementById('close-buy-sheet').addEventListener('click', closeBuy);

      confirmBuyBtn.addEventListener('click', () => {
        if (!activeCard) return;
        buySheetTitle.textContent = '正在解锁';
        buyStepConfirm.classList.add('hidden');
        buyStepLoading.classList.remove('hidden');

        buyTimer = setTimeout(() => {
          if (!activeCard) return;
          const isPlugin = isPluginCard(activeCard);
          activeCard.dataset.purchased = 'true';
          const btn = activeCard.querySelector('.buy-btn');
          btn.textContent = isPlugin ? '已购 · 下载/说明' : '已购 · 下载/查看';
          btn.className = 'buy-btn h-8 px-3.5 rounded-full bg-light-surface-container text-success font-label text-label-sm hover:bg-light-surface-container-high transition-colors duration-state-change';

          buySheetTitle.textContent = '购买成功';
          buySuccessName.textContent = activeCard.dataset.title;
          buyOpenPreviewBtn.textContent = isPlugin ? '查看安装说明' : '在线预览 / 复制';
          buyDownloadBtn.textContent = isPlugin ? '下载插件包' : '下载到本地';
          buyStepLoading.classList.add('hidden');
          buyStepSuccess.classList.remove('hidden');
        }, 900);
      });

      buyDownloadBtn.addEventListener('click', () => {
        runDownloadProgress(buyDlBox, buyDlStatus, buyDlPct, buyDlBar, buyDownloadBtn);
      });

      // ---------- 3. 已购内容预览弹窗与一键复制 ----------
      buyOpenPreviewBtn.addEventListener('click', () => {
        if (!activeCard) return;
        const isPlugin = isPluginCard(activeCard);
        closeBuy();
        previewTitle.textContent = isPlugin ? '插件安装说明' : activeCard.dataset.title;
        previewContent.textContent = activeCard.dataset.preview || '已解锁完整内容，可直接复制使用。';
        previewDlBox.classList.add('hidden');
        previewDownloadBtn.disabled = false;
        previewDownloadBtn.textContent = isPlugin ? '下载插件包' : '下载到本地';
        previewSheet.classList.remove('hidden');
      });

      function closePreview() {
        clearInterval(dlTimer);
        previewSheet.classList.add('hidden');
      }
      document.getElementById('preview-sheet-backdrop').addEventListener('click', closePreview);
      document.getElementById('close-preview-sheet').addEventListener('click', closePreview);
      previewDownloadBtn.addEventListener('click', () => {
        runDownloadProgress(previewDlBox, previewDlStatus, previewDlPct, previewDlBar, previewDownloadBtn);
      });
      document.getElementById('copy-preview-btn').addEventListener('click', () => {
        if (navigator.clipboard && previewContent.textContent) {
          navigator.clipboard.writeText(previewContent.textContent).catch(() => {});
        }
        closePreview();
        showToast('内容已复制到剪贴板');
      });

      // ---------- 4. 内测码校验与创作者商品上架 ----------
      const betaModal = document.getElementById('beta-code-modal');
      const betaForm = document.getElementById('beta-code-form');
      const betaInput = document.getElementById('beta-code-input');
      const sellSheet = document.getElementById('sell-sheet');
      const sellForm = document.getElementById('sell-form');
      let betaVerified = false;

      function closeBeta() { betaModal.classList.add('hidden'); }
      function closeSell() { sellSheet.classList.add('hidden'); }

      document.getElementById('open-sell-btn').addEventListener('click', () => {
        if (betaVerified) {
          sellSheet.classList.remove('hidden');
        } else {
          betaInput.value = '';
          betaModal.classList.remove('hidden');
        }
      });

      document.getElementById('beta-modal-backdrop').addEventListener('click', closeBeta);
      document.getElementById('close-beta-modal').addEventListener('click', closeBeta);
      document.getElementById('cancel-beta-btn').addEventListener('click', closeBeta);

      betaForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const code = betaInput.value.trim();
        if (!code) {
          showToast('请先输入内测码');
          betaInput.focus();
          return;
        }
        betaVerified = true;
        closeBeta();
        showToast('内测码验证通过');
        sellSheet.classList.remove('hidden');
      });

      document.getElementById('sell-sheet-backdrop').addEventListener('click', closeSell);
      document.getElementById('close-sell-sheet').addEventListener('click', closeSell);

      const catLabels = {
        prompts: '指令预设',
        skins: '聊天皮肤',
        presets: '设定模板',
        plugins: '功能插件'
      };

      // 提交上架表单并动态插入新商品卡片到列表顶部
      sellForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = document.getElementById('sell-title-input').value.trim();
        const cat = document.getElementById('sell-cat-input').value;
        const price = Number(document.getElementById('sell-price-input').value || 6).toFixed(2);
        const desc = document.getElementById('sell-desc-input').value.trim();
        if (!title || !desc) return;

        const isPlugin = cat === 'plugins';
        const fmt = isPlugin ? 'JSON / JS' : 'MD / TXT';
        const card = document.createElement('article');
        card.className = 'market-card rounded-lg bg-light-surface border border-light-outline-variant p-gutter-md shadow-sm flex flex-col gap-gutter-sm';
        card.dataset.category = cat;
        if (isPlugin) card.dataset.type = 'plugin';
        card.dataset.title = title;
        card.dataset.price = price;
        card.dataset.format = fmt;
        card.dataset.seller = '我 · 岛遇创作者';
        card.dataset.preview = desc;

