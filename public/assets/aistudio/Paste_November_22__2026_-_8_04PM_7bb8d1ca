      function buildGridCardHtml(card) {
        const avatarHtml = card.avatar
          ? '<img src="' + card.avatar + '" alt="' + card.author + '" class="w-4 h-4 rounded-full object-cover shrink-0">'
          : '<span class="w-4 h-4 rounded-full bg-light-surface-container-high text-light-on-surface flex items-center justify-center text-[10px] font-label shrink-0">' + (card.initial || '创') + '</span>';
        const metaHtml = card.meta
          ? '<span data-design-text-token="label-sm" class="absolute bottom-2 right-2 px-2 py-0.5 rounded-full bg-dark-surface/65 backdrop-blur-sm text-dark-on-surface font-label text-label-sm">' + card.meta + '</span>'
          : '';

        return (
          '<article class="bg-light-surface rounded-xl overflow-hidden border border-light-outline-variant/70 shadow-sm flex flex-col">' +
            '<a href="' + card.href + '" class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary">' +
              '<div class="relative ' + card.aspect + ' w-full overflow-hidden bg-light-surface-container">' +
                '<img src="' + card.img + '" alt="' + card.title + '" class="w-full h-full object-cover ' + card.imgPos + ' transition-transform duration-300 group-hover:scale-[1.03]">' +
                '<span data-design-text-token="label-sm" class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-dark-surface/70 backdrop-blur-sm text-dark-on-surface font-label text-label-sm">' + card.tag + '</span>' +
                metaHtml +
              '</div>' +
              '<div class="px-2.5 pt-2 pb-1">' +
                '<h2 data-design-text-token="body-sm" class="font-title text-body-sm font-semibold text-light-on-surface line-clamp-2 leading-snug">' + card.title + '</h2>' +
              '</div>' +
            '</a>' +
            '<div class="px-2.5 pb-2.5 pt-1 flex items-center justify-between gap-2">' +
              '<a href="../45-user-profile/UserProfile.html" class="flex items-center gap-1.5 min-w-0">' +
                avatarHtml +
                '<span data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant truncate">' + card.author + '</span>' +
              '</a>' +
              '<button type="button" class="grid-like-btn flex items-center gap-1 text-light-on-surface-variant hover:text-error transition-colors shrink-0" aria-label="点赞作品">' +
                '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
                  '<path d="M12.001 20.25C11.72 20.25 11.44 20.17 11.19 20.02C7.82 17.98 2.75 13.97 2.75 8.75C2.75 5.82 5.08 3.5 7.98 3.5C9.68 3.5 11.18 4.31 12 5.55C12.82 4.31 14.32 3.5 16.02 3.5C18.92 3.5 21.25 5.82 21.25 8.75C21.25 13.97 16.18 17.98 12.81 20.02C12.56 20.17 12.28 20.25 12.001 20.25Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>' +
                '</svg>' +
                '<span data-design-text-token="label-sm" class="grid-like-count font-label text-label-sm tabular-nums">' + card.likes + '</span>' +
              '</button>' +
            '</div>' +
          '</article>'
        );
      }

      function bindGridLikeButtons() {
        document.querySelectorAll('.grid-like-btn').forEach(function (btn) {
          const svg = btn.querySelector('svg');
          const countEl = btn.querySelector('.grid-like-count');
          let gLiked = false;
          const raw = countEl ? countEl.textContent.trim() : '0';
          const isNumeric = /^\d+$/.test(raw);
          const base = isNumeric ? parseInt(raw, 10) : null;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            gLiked = !gLiked;
            if (svg) svg.setAttribute('fill', gLiked ? 'currentColor' : 'none');
            btn.classList.toggle('text-error', gLiked);
            btn.classList.toggle('text-light-on-surface-variant', !gLiked);
            if (countEl && base !== null) {
              countEl.textContent = String(gLiked ? base + 1 : base);
            }
          });
        });
      }

      function renderDualGrid(channel) {
        if (!dualGridLeft || !dualGridRight) return;
        const list = CHANNEL_FEEDS[channel] || CHANNEL_FEEDS.recommend;
        const leftItems = [];
        const rightItems = [];
        list.forEach(function (item, idx) {
          if (idx % 2 === 0) leftItems.push(buildGridCardHtml(item));
          else rightItems.push(buildGridCardHtml(item));
        });
        dualGridLeft.innerHTML = leftItems.join('');
        dualGridRight.innerHTML = rightItems.join('');
        bindGridLikeButtons();
        if (dualGridFeed) dualGridFeed.scrollTop = 0;
      }

      function setFeedPolarity(isLight) {
        if (appShell) {
          appShell.classList.toggle('bg-light-surface-container-low', isLight);
          appShell.classList.toggle('bg-dark-surface', !isLight);
        }
        if (topNavScrim) topNavScrim.classList.toggle('hidden', isLight);
        if (topNavRow) {
          topNavRow.classList.toggle('drop-shadow-[0_1px_4px_rgba(0,0,0,0.45)]', !isLight);
        }
        if (topNavSolid) {
          topNavSolid.classList.toggle('bg-light-surface', isLight);
          topNavSolid.classList.toggle('border-light-outline-variant', isLight);
          topNavSolid.classList.toggle('bg-dark-surface', !isLight);
          topNavSolid.classList.toggle('border-dark-outline-variant/70', !isLight);
          if (isLight) topNavSolid.style.opacity = '1';
        }
        if (topNavActions) {
          topNavActions.classList.toggle('text-light-on-surface', isLight);
          topNavActions.classList.toggle('text-dark-on-surface', !isLight);
        }
        if (channelIndicator) {
          channelIndicator.classList.toggle('bg-light-on-surface', isLight);
          channelIndicator.classList.toggle('bg-dark-on-surface', !isLight);
        }
        if (bottomNav) {
          bottomNav.classList.toggle('bg-light-surface', isLight);
          bottomNav.classList.toggle('border-light-outline-variant', isLight);
          bottomNav.classList.toggle('bg-dark-surface', !isLight);
          bottomNav.classList.toggle('border-dark-outline-variant', !isLight);
        }
        if (navIndicatorPill) {
          navIndicatorPill.classList.toggle('bg-light-surface-container', isLight);
          navIndicatorPill.classList.toggle('bg-dark-surface-container', !isLight);
        }
        document.querySelectorAll('.nav-cutout').forEach(function (el) {
          el.setAttribute('fill', isLight ? '#FFFFFF' : '#121316');
        });
        if (msgBadge) {
          msgBadge.classList.toggle('ring-light-surface', isLight);
          msgBadge.classList.toggle('ring-dark-surface', !isLight);
        }
        items.forEach(function (navBtn) {
          const active = navBtn.getAttribute('aria-current') === 'page';
          navBtn.classList.remove('text-dark-on-surface', 'text-dark-on-surface-variant', 'text-light-on-surface', 'text-light-on-surface-variant');
          if (isLight) {
            navBtn.classList.add(active ? 'text-light-on-surface' : 'text-light-on-surface-variant');
          } else {
            navBtn.classList.add(active ? 'text-dark-on-surface' : 'text-dark-on-surface-variant');
          }
        });
        syncChannelTabStyles();
      }

      if (layoutToggleBtn && dualGridFeed) {
        layoutToggleBtn.addEventListener('click', function () {
          isGridMode = !isGridMode;
          layoutToggleBtn.setAttribute('aria-pressed', isGridMode ? 'true' : 'false');
          layoutToggleBtn.setAttribute('aria-label', isGridMode ? '切换单列沉浸流' : '切换双列瀑布流');

          if (iconGridMode) iconGridMode.classList.toggle('hidden', isGridMode);
          if (iconSingleMode) iconSingleMode.classList.toggle('hidden', !isGridMode);

          if (isGridMode) {
            if (isReading) stopReading(false);
            feedScroller.classList.add('hidden');
            if (immersiveBottomOverlay) immersiveBottomOverlay.classList.add('hidden');
            if (rightRail) rightRail.classList.add('hidden');
            setFeedPolarity(true);
            renderDualGrid(activeChannel);
            dualGridFeed.classList.remove('hidden');
            showHomeToast('已切换为双列浏览');
          } else {
            dualGridFeed.classList.add('hidden');
            feedScroller.classList.remove('hidden');
            if (immersiveBottomOverlay) immersiveBottomOverlay.classList.remove('hidden');
            if (rightRail) rightRail.classList.remove('hidden');
            setFeedPolarity(false);
            applyOffset(offsetY);
            showHomeToast('已切换为沉浸长文流');
          }
        });
      }

      bindGridLikeButtons();
    })();
