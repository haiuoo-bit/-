            <textarea id="bounty-desc-input" rows="3" placeholder="请写清楚悬赏具体要求：如人物设定、剧情走向、字数要求、交付格式及时间节点等..." class="w-full rounded-md bg-light-surface border border-light-outline-variant p-2.5 font-body text-body-sm text-light-on-surface placeholder:text-light-on-surface-variant focus:ring-1 focus:ring-light-secondary resize-none"></textarea>
          </div>
