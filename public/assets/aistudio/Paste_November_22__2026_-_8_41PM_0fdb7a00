  <!-- ==================== 3. 页面交互脚本：加载时序与重播控制 ==================== -->
  <script>
    (function () {
      // ---------- 1. DOM 引用与定时器状态 ----------
      const cards = Array.from(document.querySelectorAll('[data-feed-card]'));
      const statusLabel = document.getElementById('load-status-label');
      const replayBtn = document.getElementById('replay-btn');
      let loadTimer = null;

      // ---------- 2. 执行骨架屏 -> 真实内容切换序列 ----------
      function runSkeletonSequence() {
        clearTimeout(loadTimer);
        cards.forEach(function (card) {
          card.classList.remove('is-loaded');
        });
        statusLabel.textContent = '骨架屏加载中 · 1.5s 光带扫过';

        // 等待 1.6s 展示斜向光带扫过效果，随后交叉淡入真实内容
        loadTimer = setTimeout(function () {
          cards.forEach(function (card) {
            card.classList.add('is-loaded');
          });
          statusLabel.textContent = '数据已到达 · 60ms 依次浮现';
        }, 1600);
      }

      // ---------- 3. 事件绑定与首屏自动播放 ----------
      replayBtn.addEventListener('click', runSkeletonSequence);
      runSkeletonSequence();
    })();
  </script>


