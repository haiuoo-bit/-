          btn.setAttribute('aria-pressed', String(!liked));
          countEl.textContent = String(liked ? Math.max(0, val - 1) : val + 1);
          btn.classList.toggle('text-error', !liked);
          btn.classList.toggle('text-light-on-surface-variant', liked);
          const outline = btn.querySelector('.icon-outline');
          const filled = btn.querySelector('.icon-filled');
          if (outline && filled) {
            outline.classList.toggle('hidden', !liked);
            filled.classList.toggle('hidden', liked);
          }
        });
      });

      document.querySelectorAll('.bookmark-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const saved = btn.getAttribute('aria-pressed') === 'true';
          const countEl = btn.querySelector('.count');
          const val = parseInt(countEl.textContent, 10) || 0;
          btn.setAttribute('aria-pressed', String(!saved));
          countEl.textContent = String(saved ? Math.max(0, val - 1) : val + 1);
          btn.classList.toggle('text-light-secondary', !saved);
          btn.classList.toggle('text-light-on-surface-variant', saved);
          const outline = btn.querySelector('.icon-outline');
          const filled = btn.querySelector('.icon-filled');
          if (outline && filled) {
            outline.classList.toggle('hidden', !saved);
            filled.classList.toggle('hidden', saved);
          }
          showToast(saved ? '已取消收藏' : '已收藏帖子');
        });
      });

      document.querySelectorAll('.action-toast-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showToast(btn.getAttribute('data-msg') || '已触发操作');
        });
      });

      // ---------- 3. 两步投票交互（选中选项 -> 点击“立即投票”展示百分比进度条与票数） ----------
      const pollBtns = Array.from(document.querySelectorAll('.poll-choice-btn'));
      const pollSubmitBtn = document.getElementById('poll-submit-btn');
      const pollMetaText = document.getElementById('poll-meta-text');
      let selectedPollIdx = -1;
      let hasVoted = false;

      pollBtns.forEach(function (btn, idx) {
        btn.addEventListener('click', function () {
          if (hasVoted) return;
          selectedPollIdx = idx;
          pollBtns.forEach(function (b, i) {
            const active = i === idx;
            b.classList.toggle('border-light-primary', active);
            b.classList.toggle('border-light-outline-variant', !active);
            const radio = b.querySelector('.poll-radio');
            const dot = b.querySelector('.poll-dot');
            radio.classList.toggle('border-light-primary', active);
            radio.classList.toggle('border-light-outline', !active);
            dot.classList.toggle('hidden', !active);
          });
        });
      });

      pollSubmitBtn.addEventListener('click', function () {
        if (hasVoted) {
          // 演示模式：点击“重新投票”重置回未投票状态
          hasVoted = false;
          selectedPollIdx = -1;
          pollBtns.forEach(function (b) {
            b.classList.remove('border-light-primary');
            b.classList.add('border-light-outline-variant');
            b.querySelector('.poll-radio').classList.remove('hidden', 'border-light-primary');
            b.querySelector('.poll-radio').classList.add('border-light-outline');
            b.querySelector('.poll-dot').classList.add('hidden');
            b.querySelector('.poll-bar').classList.add('hidden');
            b.querySelector('.poll-pct').classList.add('hidden');
          });
          pollMetaText.textContent = '共 428 人参与 · 请选择后投票';
          pollSubmitBtn.textContent = '立即投票';
          pollSubmitBtn.classList.add('bg-light-primary', 'text-light-on-primary');
          pollSubmitBtn.classList.remove('bg-light-surface', 'text-light-on-surface-variant', 'border', 'border-light-outline-variant');
          return;
        }

        if (selectedPollIdx === -1) {
          showToast('请先选择一个投票选项');
          return;
        }

        hasVoted = true;
        const baseCounts = pollBtns.map(function (b) { return parseInt(b.getAttribute('data-votes'), 10) || 0; });
        baseCounts[selectedPollIdx] += 1;
        const total = baseCounts.reduce(function (a, b) { return a + b; }, 0);

        pollBtns.forEach(function (b, i) {
          const pct = Math.round((baseCounts[i] / total) * 100);
          const isMine = i === selectedPollIdx;
          const bar = b.querySelector('.poll-bar');
          const pctEl = b.querySelector('.poll-pct');
          b.querySelector('.poll-radio').classList.add('hidden');
          bar.classList.remove('hidden', 'bg-light-primary/10', 'bg-light-surface-container');
          bar.classList.add(isMine ? 'bg-light-primary/10' : 'bg-light-surface-container');
          bar.style.width = pct + '%';
          pctEl.classList.remove('hidden', 'text-light-on-surface', 'text-light-on-surface-variant');
          pctEl.classList.add(isMine ? 'text-light-on-surface' : 'text-light-on-surface-variant');
          pctEl.textContent = pct + '%';
        });

        pollMetaText.textContent = '已投票 · 共 ' + total + ' 人参与';
        pollSubmitBtn.textContent = '重新投票';
        pollSubmitBtn.classList.remove('bg-light-primary', 'text-light-on-primary');
        pollSubmitBtn.classList.add('bg-light-surface', 'text-light-on-surface-variant', 'border', 'border-light-outline-variant');
        showToast('投票成功');
      });

      // ---------- 4. 迷雾蓝音乐播放器（音波动效、播放/暂停、可拖拽进度条） ----------
      const totalSec = 204; // 03:24
      let currentSec = 68;  // 01:08
      let feedMusicPlaying = false;
      let musicTimer = null;
      let isDraggingTrack = false;
      const feedMusicCard = document.getElementById('feed-music-card');
      const feedPlayBtn = document.getElementById('feed-music-play-btn');
      const feedPlayIcon = document.getElementById('feed-music-play-icon');
      const feedProgress = document.getElementById('feed-music-progress');
      const feedThumb = document.getElementById('feed-music-thumb');
      const feedElapsed = document.getElementById('feed-music-elapsed');
      const feedStatus = document.getElementById('feed-music-status');
      const feedTrack = document.getElementById('feed-music-track');

      function fmtSec(s) {
        const m = Math.floor(s / 60);
        const r = Math.floor(s % 60);
        return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r;
      }

      function renderMusicProgress() {
        const pct = Math.max(0, Math.min(100, (currentSec / totalSec) * 100));
        feedProgress.style.width = pct + '%';
        feedThumb.style.left = pct + '%';
        feedElapsed.textContent = fmtSec(currentSec);
        feedTrack.setAttribute('aria-valuenow', String(currentSec));
      }

      const feedPlayLabel = document.getElementById('feed-music-play-label');
      function setPlaying(playing) {
        feedMusicPlaying = playing;
        if (feedMusicCard) feedMusicCard.classList.toggle('is-playing', playing);
        feedPlayIcon.innerHTML = playing
          ? '<rect x="7" y="5.5" width="3.5" height="13" rx="1"/><rect x="13.5" y="5.5" width="3.5" height="13" rx="1"/>'
          : '<path d="M8 5.5V18.5L18.5 12L8 5.5Z"/>';
        feedPlayLabel.textContent = playing ? '暂停' : '播放';
        feedStatus.textContent = playing ? '· 正在播放' : '· 点击播放';
        clearInterval(musicTimer);
        if (playing) {
          musicTimer = setInterval(function () {
            if (isDraggingTrack) return;
            currentSec = currentSec >= totalSec ? 0 : currentSec + 1;
            renderMusicProgress();
          }, 1000);
        }
      }

      function seekFromClientX(clientX) {
        const rect = feedTrack.getBoundingClientRect();
        if (!rect.width) return;
        const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        currentSec = Math.round(ratio * totalSec);
        renderMusicProgress();
      }

      feedPlayBtn.addEventListener('click', function () {
        setPlaying(!feedMusicPlaying);
      });

      feedTrack.addEventListener('pointerdown', function (e) {
        isDraggingTrack = true;
        if (feedTrack.setPointerCapture) {
          try { feedTrack.setPointerCapture(e.pointerId); } catch (_) {}
        }
        seekFromClientX(e.clientX);
      });

      feedTrack.addEventListener('pointermove', function (e) {
        if (!isDraggingTrack) return;
        seekFromClientX(e.clientX);
      });

      function endTrackDrag(e) {
        if (!isDraggingTrack) return;
        isDraggingTrack = false;
        if (feedTrack.releasePointerCapture) {
          try { feedTrack.releasePointerCapture(e.pointerId); } catch (_) {}
        }
      }
      feedTrack.addEventListener('pointerup', endTrackDrag);
      feedTrack.addEventListener('pointercancel', endTrackDrag);
    })();
  </script>


