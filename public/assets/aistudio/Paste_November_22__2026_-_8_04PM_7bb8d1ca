                  摩挲旧怀表的小动作好有画面感，蹲一个后续家族旧案反转！
                </p>
                <div class="flex items-center justify-between pt-gutter-xs">
                  <div class="flex items-center gap-gutter-md font-body text-body-sm text-light-on-surface-variant tabular-nums">
                    <span data-design-text-token="body-sm">2小时前</span>
                    <button type="button" data-reply-author="林听风" class="drawer-reply-btn text-light-on-surface-variant hover:text-light-on-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">回复</button>
                  </div>
                  <button type="button" class="drawer-like-btn flex items-center gap-gutter-xs text-light-on-surface-variant hover:text-error transition-colors duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12.62 20.55C12.28 20.67 11.72 20.67 11.38 20.55C8.48 19.56 2 15.43 2 8.43C2 5.34 4.49 2.84 7.56 2.84C9.38 2.84 10.99 3.72 12 5.08C13.01 3.72 14.63 2.84 16.44 2.84C19.51 2.84 22 5.34 22 8.43C22 15.43 15.52 19.56 12.62 20.55Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span data-design-text-token="label-sm" class="drawer-like-count font-label text-label-sm tabular-nums">19</span>
                  </button>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <!-- [表单] 抽屉底部评论输入栏（提交后实时插入列表并持久化至 localStorage） -->
        <form id="drawer-comment-form" class="shrink-0 px-gutter-lg pt-gutter-sm pb-gutter-lg border-t border-light-outline-variant bg-light-surface flex items-center gap-gutter-sm">
          <div class="flex-1 flex items-center bg-light-surface-container rounded-full px-gutter-md py-gutter-sm">
            <input id="drawer-comment-input" type="text" placeholder="分享你此刻的想法..." class="w-full bg-transparent border-0 p-0 text-body-sm text-light-on-surface placeholder:text-light-on-surface-variant focus:ring-0">
          </div>
          <!-- [按钮] 发送评论 -->
          <button type="submit" class="px-gutter-md py-gutter-sm rounded-full bg-light-primary text-light-on-primary font-label text-label-sm shrink-0 hover:opacity-90 transition-opacity duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary">
            <span data-design-text-token="label-sm">发送</span>
          </button>
        </form>
      </section>
    </div>
  </main>

  <!-- ==================== 6. 页面交互脚本（背景自动滚动、频道切换、底部导航与评论抽屉同步） ==================== -->
  <script>
    (function () {
      // ---------- 1. 背景沉浸长文流 GPU 自动滚动（弹窗打开时作为底图） ----------
      const feedScroller = document.getElementById('feed-scroller');
      const feedTrack = document.getElementById('feed-track');
      const topNavSolid = document.getElementById('top-nav-solid');
      const pauseIndicator = document.getElementById('center-pause-indicator');

      let offsetY = 0;
      let autoScrollRaf = null;
      let isReading = false;
      let lastTime = null;
      let touchMoved = false;
      const SPEED_PX_PER_SEC = 22; // 自动阅读滚动速率（px/秒）

      function getMaxOffset() {
        return Math.max(0, feedTrack.scrollHeight - feedScroller.clientHeight);
      }

      // 应用纵向偏移并同步顶部导航实底渐变透明度
      function applyOffset(nextY) {
        const maxOffset = getMaxOffset();
        offsetY = Math.max(0, Math.min(maxOffset, nextY));
        feedTrack.style.transform = 'translate3d(0, ' + (-offsetY.toFixed(2)) + 'px, 0)';
        if (topNavSolid) {
          const progress = Math.min(1, Math.max(0, (offsetY - 40) / 180));
          topNavSolid.style.opacity = progress.toFixed(3);
        }
      }

      function stepScroll(now) {
        if (!isReading) return;
        if (lastTime !== null) {
          const dt = Math.min(0.05, (now - lastTime) / 1000);
          applyOffset(offsetY + SPEED_PX_PER_SEC * dt);
          if (offsetY >= getMaxOffset() - 1) {
            stopReading(true);
            return;
          }
        }
        lastTime = now;
        autoScrollRaf = requestAnimationFrame(stepScroll);
      }

      function startReading() {
        if (offsetY >= getMaxOffset() - 8) {
          applyOffset(0);
        }
        isReading = true;
        lastTime = null;
        if (pauseIndicator) pauseIndicator.classList.add('hidden');
        autoScrollRaf = requestAnimationFrame(stepScroll);
      }

      function stopReading(showIndicator) {
        isReading = false;
        lastTime = null;
        if (autoScrollRaf) cancelAnimationFrame(autoScrollRaf);
        if (pauseIndicator && showIndicator !== false) {
          pauseIndicator.classList.remove('hidden');
        }
      }

      // 点击画布切换自动滚动/暂停
      feedScroller.addEventListener('click', function () {
        if (touchMoved) {
          touchMoved = false;
          return;
        }
        if (isReading) {
          stopReading(true);
        } else {
          startReading();
        }
      });

      // 支持鼠标滚轮与触屏拖拽浏览
      feedScroller.addEventListener('wheel', function (e) {
        e.preventDefault();
        if (isReading) stopReading();
        applyOffset(offsetY + e.deltaY * 0.6);
      }, { passive: false });

      let touchStartY = null;
      feedScroller.addEventListener('touchstart', function (e) {
        touchMoved = false;
        if (isReading) stopReading(false);
        if (e.touches && e.touches.length) touchStartY = e.touches[0].clientY;
      }, { passive: true });
      feedScroller.addEventListener('touchmove', function (e) {
        if (touchStartY === null || !e.touches || !e.touches.length) return;
        touchMoved = true;
        const dy = touchStartY - e.touches[0].clientY;
        touchStartY = e.touches[0].clientY;
        applyOffset(offsetY + dy);
      }, { passive: true });
      feedScroller.addEventListener('touchend', function () {
        touchStartY = null;
      }, { passive: true });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setTimeout(function () {
          if (!isReading && offsetY === 0) {
            startReading();
          }
        }, 1200);
      }

      // ---------- 2. 顶部频道标签切换与下划线指示器定位 ----------
      const channelTabs = document.querySelectorAll('.channel-tab');
      const channelIndicator = document.getElementById('channel-indicator');
      let activeChannelTab = channelTabs.length ? channelTabs[0] : null;
      function positionChannelIndicator(tab) {
        if (!channelIndicator || !tab) return;
        const centerX = tab.offsetLeft + (tab.offsetWidth - channelIndicator.offsetWidth) / 2;
        channelIndicator.style.transform = 'translateX(' + centerX.toFixed(1) + 'px)';
      }
      if (activeChannelTab) {
        positionChannelIndicator(activeChannelTab);
        requestAnimationFrame(function () { positionChannelIndicator(activeChannelTab); });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { positionChannelIndicator(activeChannelTab); });
        }
        window.addEventListener('resize', function () { positionChannelIndicator(activeChannelTab); });
      }
      channelTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activeChannelTab = tab;
          channelTabs.forEach(function (other) {
            other.classList.remove('text-dark-on-surface');
            other.classList.add('text-dark-on-surface/75');
          });
          tab.classList.remove('text-dark-on-surface/75');
          tab.classList.add('text-dark-on-surface');
          positionChannelIndicator(tab);
        });
      });

      // ---------- 3. 右侧竖向操作栏交互（关注 / 点赞 / 收藏） ----------
      const followBtn = document.getElementById('follow-btn');
      const followAdd = document.getElementById('follow-icon-add');
      const followCheck = document.getElementById('follow-icon-check');
      const homeToast = document.getElementById('home-toast');
      let homeToastTimer = null;
      let followed = false;

      function showHomeToast(msg) {
        if (!homeToast) return;
        homeToast.textContent = msg;
        homeToast.classList.remove('hidden');
        if (homeToastTimer) clearTimeout(homeToastTimer);
        homeToastTimer = setTimeout(function () {
          homeToast.classList.add('hidden');
        }, 1600);
      }

      followBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        followed = !followed;
        followAdd.classList.toggle('hidden', followed);
        followCheck.classList.toggle('hidden', !followed);
        followBtn.classList.toggle('bg-error', !followed);
        followBtn.classList.toggle('text-light-on-primary', !followed);
        followBtn.classList.toggle('bg-light-surface', followed);
        followBtn.classList.toggle('text-light-on-surface', followed);
        followBtn.setAttribute('aria-label', followed ? '取消关注作者' : '关注作者');
        showHomeToast(followed ? '已关注 @零度叙事' : '已取消关注');
      });

      const likeBtn = document.getElementById('like-btn');
      const likeSvg = document.getElementById('like-svg');
      const likeCount = document.getElementById('like-count');
      let liked = false;
      likeBtn.addEventListener('click', function () {
        liked = !liked;
        likeSvg.setAttribute('fill', liked ? 'currentColor' : 'none');
        likeSvg.classList.toggle('text-error', liked);
        likeCount.textContent = liked ? '3.3万' : '3.2万';
      });

      const collectBtn = document.getElementById('collect-btn');
      const collectSvg = document.getElementById('collect-svg');
      const collectCount = document.getElementById('collect-count');
      let collected = false;
      collectBtn.addEventListener('click', function () {
        collected = !collected;
        collectSvg.setAttribute('fill', collected ? 'currentColor' : 'none');
        collectSvg.classList.toggle('text-dark-secondary', collected);
        collectCount.textContent = collected ? '1.2万' : '1.1万';
      });

      // ---------- 4. 底部五 Tab 导航栏切换 ----------
      const items = Array.from(document.querySelectorAll('.nav-item'));
      const indicator = document.getElementById('nav-indicator');
      const msgBadge = document.getElementById('msg-badge');
      items.forEach(function (btn, index) {
        btn.addEventListener('click', function () {
          items.forEach(function (other) {
            other.removeAttribute('aria-current');
            other.classList.remove('text-dark-on-surface');
            other.classList.add('text-dark-on-surface-variant');
          });
          btn.setAttribute('aria-current', 'page');
          btn.classList.remove('text-dark-on-surface-variant');
          btn.classList.add('text-dark-on-surface');
          if (indicator) indicator.style.transform = 'translateX(' + (index * 100) + '%)';
          if (btn.getAttribute('data-tab') === 'messages' && msgBadge) {
            msgBadge.classList.add('hidden');
          }
        });
      });

      // ---------- 5. 半屏评论抽屉交互（默认展开，通过 localStorage 与 06/07 页互通） ----------
      const commentBtn = document.getElementById('comment-btn');
      const commentDrawer = document.getElementById('comment-drawer');
      const commentDrawerPanel = document.getElementById('comment-drawer-panel');
      const commentBackdrop = document.getElementById('comment-backdrop');
      const closeCommentDrawer = document.getElementById('close-comment-drawer');
      const drawerCommentForm = document.getElementById('drawer-comment-form');
      const drawerCommentInput = document.getElementById('drawer-comment-input');
      const drawerCommentList = document.getElementById('drawer-comment-list');
      const drawerCommentTotal = document.getElementById('drawer-comment-total');
      const homeCommentCount = document.getElementById('home-comment-count');
      let totalDrawerComments = 586;
      let drawerCloseTimer = null;

      function openDrawer() {
        if (isReading) stopReading();
        clearTimeout(drawerCloseTimer);
        commentDrawer.classList.remove('hidden');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            commentDrawer.classList.remove('opacity-0');
            commentDrawer.classList.add('opacity-100');
            if (commentDrawerPanel) {
              commentDrawerPanel.classList.remove('translate-y-full');
              commentDrawerPanel.classList.add('translate-y-0');
            }
          });
        });
      }
      function closeDrawer() {
        commentDrawer.classList.remove('opacity-100');
        commentDrawer.classList.add('opacity-0');
        if (commentDrawerPanel) {
          commentDrawerPanel.classList.remove('translate-y-0');
          commentDrawerPanel.classList.add('translate-y-full');
        }
        clearTimeout(drawerCloseTimer);
        drawerCloseTimer = setTimeout(function () {
          commentDrawer.classList.add('hidden');
        }, 280);
      }
      if (commentBtn) commentBtn.addEventListener('click', openDrawer);
      if (closeCommentDrawer) closeCommentDrawer.addEventListener('click', closeDrawer);
      if (commentBackdrop) commentBackdrop.addEventListener('click', closeDrawer);

      const drawerHeartSvg = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12.62 20.55C12.28 20.67 11.72 20.67 11.38 20.55C8.48 19.56 2 15.43 2 8.43C2 5.34 4.49 2.84 7.56 2.84C9.38 2.84 10.99 3.72 12 5.08C13.01 3.72 14.63 2.84 16.44 2.84C19.51 2.84 22 5.34 22 8.43C22 15.43 15.52 19.56 12.62 20.55Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      let replyTarget = null;
      function resetReplyTarget() {
        replyTarget = null;
        if (drawerCommentInput) drawerCommentInput.placeholder = '分享你此刻的想法...';
      }

      if (drawerCommentList) {
        drawerCommentList.addEventListener('click', function (e) {
          if (e.target.closest('a') || e.target.closest('.collapse-replies-btn')) return;
          const likeBtn = e.target.closest('.drawer-like-btn');
          if (likeBtn) {
            const countEl = likeBtn.querySelector('.drawer-like-count');
            const svg = likeBtn.querySelector('svg');
            const cLiked = likeBtn.getAttribute('aria-pressed') === 'true';
            likeBtn.setAttribute('aria-pressed', String(!cLiked));
            if (svg) svg.setAttribute('fill', !cLiked ? 'currentColor' : 'none');
            likeBtn.classList.toggle('text-error', !cLiked);
            likeBtn.classList.toggle('text-light-on-surface-variant', cLiked);
            if (countEl) countEl.textContent = String((parseInt(countEl.textContent, 10) || 0) + (cLiked ? -1 : 1));
            return;
          }
          const replyBtn = e.target.closest('.drawer-reply-btn');
          const subItem = e.target.closest('.sub-comment-item');
          const parentLi = e.target.closest('.comment-item');
          const trigger = replyBtn || subItem || parentLi;
          if (trigger && parentLi) {
            const author = trigger.dataset.replyAuthor || parentLi.dataset.replyAuthor || '该用户';
            replyTarget = { author: author, li: parentLi };
            if (drawerCommentInput) {
              drawerCommentInput.placeholder = '回复 @' + author + '...';
              drawerCommentInput.focus();
            }
          }
        });
      }

      function prependDrawerComment(text) {
        const li = document.createElement('li');
        li.className = 'comment-item flex items-start gap-gutter-md';
        li.dataset.replyAuthor = '我';
        li.innerHTML =
          '<a href="../45-user-profile/UserProfile.html" aria-label="查看我的主页" class="w-8 h-8 rounded-full bg-light-surface-container-high flex items-center justify-center shrink-0 font-label text-label-sm text-light-on-surface hover:opacity-85 transition-opacity">我</a>' +
          '<div class="flex-1 min-w-0 flex flex-col gap-gutter-xs">' +
            '<a href="../45-user-profile/UserProfile.html" data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant hover:text-light-on-surface transition-colors self-start">我</a>' +
            '<p data-design-text-token="body-md" class="comment-body cursor-pointer font-body text-body-md text-light-on-surface text-pretty"></p>' +
            '<div class="flex items-center justify-between pt-gutter-xs">' +
              '<div class="flex items-center gap-gutter-md font-body text-body-sm text-light-on-surface-variant tabular-nums">' +
                '<span data-design-text-token="body-sm">刚刚</span>' +
                '<button type="button" data-reply-author="我" class="drawer-reply-btn text-light-on-surface-variant hover:text-light-on-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">回复</button>' +
              '</div>' +
              '<button type="button" class="drawer-like-btn flex items-center gap-gutter-xs text-light-on-surface-variant hover:text-error transition-colors duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">' +
                drawerHeartSvg + '<span data-design-text-token="label-sm" class="drawer-like-count font-label text-label-sm tabular-nums">0</span>' +
              '</button>' +
            '</div>' +
          '</div>';
        li.querySelector('p').textContent = text;
        drawerCommentList.prepend(li);
      }

      const COMMENT_STORAGE_KEY = 'renshedao_jinghua_comments';
      let savedComments = [];
      try {
        savedComments = JSON.parse(localStorage.getItem(COMMENT_STORAGE_KEY) || '[]');
        if (Array.isArray(savedComments) && savedComments.length) {
          savedComments.forEach(function (txt) { prependDrawerComment(txt); });
          totalDrawerComments += savedComments.length;
          drawerCommentTotal.textContent = String(totalDrawerComments);
          homeCommentCount.textContent = String(totalDrawerComments);
        }
      } catch (e) {}

      if (drawerCommentForm) {
        drawerCommentForm.addEventListener('submit', function (e) {
          e.preventDefault();
          const text = drawerCommentInput.value.trim();
          if (!text) return;
          totalDrawerComments += 1;
          drawerCommentTotal.textContent = String(totalDrawerComments);
          homeCommentCount.textContent = String(totalDrawerComments);
          if (replyTarget && replyTarget.li) {
            const bodyCol = replyTarget.li.querySelector('.flex-1');
            let subBox = replyTarget.li.querySelector('.sub-replies-box');
            if (!subBox && bodyCol) {
              subBox = document.createElement('div');
              subBox.className = 'sub-replies-box mt-gutter-sm flex flex-col gap-gutter-md';
              bodyCol.appendChild(subBox);
            }
            if (subBox) {
              const sub = document.createElement('div');
              sub.className = 'sub-comment-item flex items-start gap-gutter-sm';
              sub.dataset.replyAuthor = '我';
              sub.innerHTML =
                '<a href="../45-user-profile/UserProfile.html" aria-label="查看我的主页" class="w-6 h-6 rounded-full bg-light-surface-container-high flex items-center justify-center shrink-0 font-label text-label-sm text-light-on-surface hover:opacity-85 transition-opacity">我</a>' +
                '<div class="flex-1 min-w-0 flex flex-col gap-gutter-xs">' +
                '  <div class="flex items-center gap-gutter-xs font-label text-label-sm text-light-on-surface-variant">' +
                '    <a href="../45-user-profile/UserProfile.html" class="hover:text-light-on-surface transition-colors">我</a><span aria-hidden="true">▸</span><a href="../45-user-profile/UserProfile.html" class="reply-to-name hover:text-light-on-surface transition-colors"></a>' +
                '  </div>' +
                '  <p class="comment-body cursor-pointer font-body text-body-md text-light-on-surface text-pretty"></p>' +
                '  <div class="flex items-center justify-between pt-gutter-xs">' +
                '    <div class="flex items-center gap-gutter-md font-body text-body-sm text-light-on-surface-variant tabular-nums">' +
                '      <span>刚刚</span>' +
                '      <button type="button" data-reply-author="我" class="drawer-reply-btn text-light-on-surface-variant hover:text-light-on-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">回复</button>' +
                '    </div>' +
                '    <button type="button" class="drawer-like-btn flex items-center gap-gutter-xs text-light-on-surface-variant hover:text-error transition-colors duration-state-change focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary rounded-sm">' +
                drawerHeartSvg + '<span class="drawer-like-count font-label text-label-sm tabular-nums">0</span>' +
                '    </button>' +
                '  </div>' +
                '</div>';
              sub.querySelector('.reply-to-name').textContent = replyTarget.author;
              sub.querySelector('p').textContent = text;
              subBox.appendChild(sub);
            }
          } else {
            prependDrawerComment(text);
            savedComments.push(text);
            try { localStorage.setItem(COMMENT_STORAGE_KEY, JSON.stringify(savedComments)); } catch (err) {}
          }
          resetReplyTarget();
          drawerCommentInput.value = '';
        });
      }
    })();
  </script>


