        ]
      };

      const tabs = Array.from(document.querySelectorAll('.rank-tab'));
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.forEach(function (b) {
            const active = b === t;
            b.classList.toggle('bg-light-primary', active);
            b.classList.toggle('text-light-on-primary', active);
            b.classList.toggle('bg-light-surface-container', !active);
            b.classList.toggle('text-light-on-surface-variant', !active);
          });
          const board = t.getAttribute('data-board');
          const rows = boardData[board];
          if (!rows) return;
          rows.forEach(function (item, i) {
            const card = document.getElementById('rank-card-' + (i + 1));
            if (!card) return;
            const titleEl = card.querySelector('.rank-title');
            const authorEl = card.querySelector('.rank-author');
            const tagEl = card.querySelector('.rank-tag');
            const voteBtn = card.querySelector('.vote-btn');
            const voteCountEl = card.querySelector('.vote-count');
            if (titleEl) titleEl.textContent = item.title;
            if (authorEl) authorEl.textContent = item.author;
            if (tagEl) tagEl.textContent = item.tag;
            if (voteBtn) {
