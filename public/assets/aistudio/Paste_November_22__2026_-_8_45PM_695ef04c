  <script>
    (function () {
      const tabs = document.querySelectorAll('.sub-author-tab');
      const cards = document.querySelectorAll('.sub-card');
      const readAllBtn = document.getElementById('sub-read-all-btn');
      const toast = document.getElementById('sub-toast');
      let toastTimer = null;

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      // 点击顶部横向博主头像筛选对应更新
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const author = tab.dataset.author;
          tabs.forEach((t) => {
            const active = t === tab;
            const ring = t.querySelector('.sub-avatar-ring');
            const name = t.querySelector('.sub-author-name');
            if (name) {
              name.classList.toggle('font-title', active);
              name.classList.toggle('text-light-on-surface', active);
              name.classList.toggle('font-label', !active);
              name.classList.toggle('text-light-on-surface-variant', !active);
            }
            if (ring) {
              ring.classList.toggle('ring-2', active);
              ring.classList.toggle('ring-light-primary', active);
            }
          });
          cards.forEach((card) => {
            card.classList.toggle('hidden', author !== 'all' && card.dataset.author !== author);
          });
        });
      });

      // 全部已读
      if (readAllBtn) {
        readAllBtn.addEventListener('click', () => {
          document.querySelectorAll('.sub-dot, .sub-pill-dot').forEach((d) => d.classList.add('hidden'));
          showToast('已将订阅上新全部标为已读');
        });
      }
    })();
  </script>


