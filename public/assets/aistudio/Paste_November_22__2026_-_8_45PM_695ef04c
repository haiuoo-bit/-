        发送
      </button>
    </div>

    <!-- 轻提示 Toast -->
    <div id="inter-toast" role="status" aria-live="polite" class="hidden fixed bottom-16 left-1/2 -translate-x-1/2 z-40 px-4 py-2 rounded-full bg-dark-surface-container/95 text-dark-on-surface font-label text-label-sm shadow-lg whitespace-nowrap"></div>
  </main>

  <script>
    (function () {
      const tabs = document.querySelectorAll('.inter-tab');
      const items = document.querySelectorAll('.inter-item');
      const readAllBtn = document.getElementById('inter-read-all-btn');
      const replyBar = document.getElementById('inter-reply-bar');
      const replyInput = document.getElementById('inter-reply-input');
      const replySend = document.getElementById('inter-reply-send');
      const toast = document.getElementById('inter-toast');
      let toastTimer = null;
      let activeReplyItem = null;

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      function submitReply() {
        const val = replyInput.value.trim();
        if (!val) {
          showToast('请输入回复内容');
          return;
        }
        if (activeReplyItem) {
          const box = activeReplyItem.querySelector('.inter-my-reply');
          if (box) {
            box.textContent = '我：' + val;
            box.classList.remove('hidden');
          }
        }
        replyInput.value = '';
        replyBar.classList.add('hidden');
        showToast('回复已发送');
      }

      // 分段标签切换与筛选
      const tabIndicator = document.getElementById('msgi-tab-indicator-bar');
      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => {
          const f = tab.dataset.filter;
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('font-title', active);
            t.classList.toggle('text-light-on-surface', active);
            t.classList.toggle('font-label', !active);
            t.classList.toggle('text-light-on-surface-variant', !active);
          });
          if (tabIndicator) {
            tabIndicator.style.transform = 'translateX(' + (idx * 100) + '%)';
          }
          items.forEach((item) => {
            item.classList.toggle('hidden', f !== 'all' && item.dataset.type !== f);
          });
          replyBar.classList.add('hidden');
        });
      });

      // 全部已读
      if (readAllBtn) {
        readAllBtn.addEventListener('click', () => {
          document.querySelectorAll('.inter-dot, .inter-tab-dot').forEach((d) => d.classList.add('hidden'));
          showToast('已将互动信息全部标为已读');
        });
      }

      // 列表内交互：点击标为已读、回关、点赞评论、弹出底部回复栏
      document.getElementById('inter-list').addEventListener('click', (e) => {
        const row = e.target.closest('.inter-item');
        if (row) {
          const dot = row.querySelector('.inter-dot');
          if (dot && !dot.classList.contains('hidden')) dot.classList.add('hidden');
        }

        const followBtn = e.target.closest('.inter-follow-btn');
        if (followBtn) {
          const on = followBtn.getAttribute('data-followed') === 'true';
          followBtn.setAttribute('data-followed', !on ? 'true' : 'false');
          followBtn.textContent = !on ? '已互关' : '+ 回关';
          followBtn.className = !on
            ? 'inter-follow-btn h-8 px-3.5 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm shrink-0 transition-colors'
            : 'inter-follow-btn h-8 px-3.5 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm shrink-0 transition-colors';
          showToast(!on ? '已回关创作者' : '已取消关注');
          return;
        }

        const likeBtn = e.target.closest('.inter-like-comment');
        if (likeBtn) {
          const liked = likeBtn.getAttribute('data-liked') === 'true';
          likeBtn.setAttribute('data-liked', !liked ? 'true' : 'false');
          likeBtn.classList.toggle('text-error', !liked);
          likeBtn.classList.toggle('text-light-on-surface-variant', liked);
          const svg = likeBtn.querySelector('svg');
          if (svg) svg.setAttribute('fill', !liked ? 'currentColor' : 'none');
          likeBtn.querySelector('span').textContent = !liked ? '已赞' : '赞';
          showToast(!liked ? '已点赞该评论' : '已取消点赞');
          return;
        }

        const replyTrigger = e.target.closest('.inter-reply-trigger');
        if (replyTrigger) {
          activeReplyItem = replyTrigger.closest('.inter-item');
          const user = activeReplyItem.dataset.user || '对方';
          replyInput.placeholder = '回复 ' + user + '...';
          replyBar.classList.remove('hidden');
          replyInput.focus();
        }
      });

      if (replySend) replySend.addEventListener('click', submitReply);
      if (replyInput) {
        replyInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            submitReply();
          } else if (e.key === 'Escape') {
            replyBar.classList.add('hidden');
          }
        });
      }
    })();
  </script>


