  <script>
    (function () {
      // ---------- 1. DOM 引用与筛选状态 ----------
      const tabs = Array.from(document.querySelectorAll('.bounty-tab'));
      const topicPills = Array.from(document.querySelectorAll('.topic-pill'));
      const customPanel = document.getElementById('panel-custom');
      const bountyPanel = document.getElementById('panel-bounty');
      const flowSteps = document.getElementById('flow-steps');
      const filterEmpty = document.getElementById('filter-empty');
      const resetTopicBtn = document.getElementById('reset-topic-btn');
      const yueCard = document.getElementById('creator-card-yuejiancao');
      const countEl = document.getElementById('active-creators-count');
      let currentPanel = 'custom';
      let currentTopic = '全部';
      let yueAccepting = true;

      // ---------- 2. 从 localStorage 同步 44 创作者接单设置（月见草卡片） ----------
      try {
        const raw = localStorage.getItem('island_creator_commission');
        if (raw) {
          const data = JSON.parse(raw);
          if (typeof data.accepting === 'boolean') {
            yueAccepting = data.accepting;
            if (yueCard && (!yueAccepting || (data.slotMode && data.remainingSlots === 0))) {
              yueCard.setAttribute('data-closed', 'true');
            }
          }
          const yueBadge = document.getElementById('yue-status-badge');
          if (yueBadge && data.slotMode && typeof data.remainingSlots === 'number' && data.remainingSlots > 0) {
            yueBadge.textContent = '余' + data.remainingSlots + '档期';
            yueBadge.className = 'px-2.5 py-0.5 rounded-full bg-warning text-light-on-primary font-label text-label-sm shrink-0';
          }
          if (data.budget) {
            const bEl = document.getElementById('yue-budget');
            if (bEl) bEl.textContent = '￥' + data.budget;
          }
          if (data.turnaround) {
            const tEl = document.getElementById('yue-turnaround');
            if (tEl) tEl.textContent = '起 · ' + data.turnaround;
          }
          if (data.goodNote) {
            const gEl = document.getElementById('yue-good-note');
            if (gEl) gEl.textContent = data.goodNote;
          }
          if (Array.isArray(data.acceptTags) && data.acceptTags.length > 0) {
            const tagsEl = document.getElementById('yue-tags');
            if (tagsEl) {
              tagsEl.innerHTML = data.acceptTags.slice(0, 3).map(function (t) {
                return '<span class="px-2 py-0.5 rounded-sm bg-light-surface-container font-label text-label-sm text-light-on-surface-variant">#' + t + '</span>';
              }).join('');
            }
          }
        }
      } catch (e) {}

      // ---------- 3. 根据当前面板与题材过滤卡片并更新计数 ----------
      function applyFilter() {
        const activePanel = currentPanel === 'custom' ? customPanel : bountyPanel;
        const cards = activePanel ? Array.from(activePanel.querySelectorAll('.bounty-card')) : [];
        let visibleCount = 0;

        cards.forEach(function (card) {
          if (card.getAttribute('data-closed') === 'true') {
            card.classList.add('hidden');
            return;
          }
          const topics = (card.getAttribute('data-topics') || '').split(',');
          const match = currentTopic === '全部' || topics.indexOf(currentTopic) !== -1;
          card.classList.toggle('hidden', !match);
          if (match) visibleCount++;
        });

        if (currentPanel === 'custom' && countEl) {
          countEl.textContent = '共 ' + visibleCount + ' 位可约';
        }
        if (filterEmpty) {
          filterEmpty.classList.toggle('hidden', visibleCount > 0);
        }
      }

      // ---------- 4. 顶部「定制约稿 / 悬赏征稿」分段切换 ----------
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          currentPanel = t.getAttribute('data-panel');
          tabs.forEach(function (b) {
            const active = b === t;
            b.classList.toggle('bg-light-surface', active);
            b.classList.toggle('text-light-on-surface', active);
            b.classList.toggle('shadow-sm', active);
            b.classList.toggle('text-light-on-surface-variant', !active);
          });
          customPanel.classList.toggle('hidden', currentPanel !== 'custom');
          customPanel.classList.toggle('flex', currentPanel === 'custom');
          bountyPanel.classList.toggle('hidden', currentPanel !== 'bounty');
          bountyPanel.classList.toggle('flex', currentPanel === 'bounty');
          if (flowSteps) {
            const cells = flowSteps.querySelectorAll('.flow-step-text');
            if (currentPanel === 'custom') {
              cells[0].textContent = '沟通人设';
              cells[1].textContent = '担保托管';
              cells[2].textContent = '满意交付';
            } else {
              cells[0].textContent = '发布赏金';
              cells[1].textContent = '多人投稿';
              cells[2].textContent = '中标结算';
            }
          }
          applyFilter();
        });
      });

      // ---------- 5. 题材胶囊筛选与空状态重置 ----------
      topicPills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          currentTopic = pill.getAttribute('data-topic') || '全部';
          topicPills.forEach(function (p) {
            const active = p === pill;
            p.className = active
              ? 'topic-pill shrink-0 px-3 py-1 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm transition-colors'
              : 'topic-pill shrink-0 px-3 py-1 rounded-full bg-light-surface-container text-light-on-surface-variant font-label text-label-sm transition-colors';
          });
          applyFilter();
        });
      });

      if (resetTopicBtn) {
        resetTopicBtn.addEventListener('click', function () {
          const allPill = topicPills[0];
          if (allPill) allPill.click();
        });
      }

      // 初始化筛选状态
      applyFilter();
    })();
  </script>


