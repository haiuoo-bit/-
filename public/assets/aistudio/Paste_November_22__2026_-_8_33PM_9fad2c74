              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 4V15M12 15L8 11M12 15L16 11" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M5 18H19" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"></path>
              </svg>
              <span>下载设定文档</span>
            </button>

            <button id="upload-proof-btn" type="button" class="h-11 px-3 rounded-md bg-light-surface border border-light-outline-variant hover:border-light-secondary flex items-center justify-center gap-1.5 font-label text-label-sm text-light-on-surface transition-transform duration-state-change active:scale-95">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 16V5M12 5L8 9M12 5L16 9" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M5 19H19" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"></path>
              </svg>
              <span id="upload-proof-label">上传通关截图</span>
            </button>
          </div>

          <p id="proof-status-text" class="hidden font-body text-body-sm text-success">已上传通关结算截图（待房主核验发放奖励）</p>
