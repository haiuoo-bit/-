        <!-- [配件 6] 背景音乐（先上传本地音频，再展开迷雾蓝迷你播放器） -->
        <section id="mod-music" class="hidden p-gutter-sm rounded-lg bg-light-surface-container-low border border-light-outline-variant/80 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <span class="font-label text-label-sm text-light-on-surface">背景音乐</span>
            <button type="button" data-close-mod="mod-music" class="close-mod-btn font-label text-label-sm text-light-on-surface-variant hover:text-error">移除</button>
          </div>
          <input id="music-file-input" type="file" accept="audio/*" class="hidden">
          <audio id="music-audio" class="hidden"></audio>

          <!-- 状态 1：未上传音频时的空状态引导卡片 -->
          <div id="music-empty-state" class="p-3 rounded-md bg-light-surface border border-dashed border-light-outline flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-9 h-9 rounded-md bg-light-surface-container flex items-center justify-center text-light-on-surface shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9 17.5V6.5L19 4.5V15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  <circle cx="6.75" cy="17.5" r="2.25" stroke="currentColor" stroke-width="1.8"></circle>
                  <circle cx="16.75" cy="15.5" r="2.25" stroke="currentColor" stroke-width="1.8"></circle>
                </svg>
              </div>
              <div class="flex-1 min-w-0 flex flex-col">
                <span class="font-label text-label-sm text-light-on-surface truncate">上传本地音频文件</span>
                <span class="font-body text-body-sm text-light-on-surface-variant truncate">支持 MP3 / WAV / FLAC / M4A</span>
              </div>
            </div>
            <button id="upload-music-btn" type="button" class="shrink-0 h-8 px-3 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm transition-transform duration-state-change active:scale-95">上传音乐</button>
          </div>

          <!-- 状态 2：上传成功后的迷雾蓝迷你音乐播放器 -->
          <div id="music-player-card" class="hidden rounded-lg bg-light-surface border border-light-outline-variant/80 p-3 shadow-sm flex flex-col gap-2.5">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-light-secondary/10 flex items-center justify-center shrink-0">
                <svg class="w-7 h-7 text-light-secondary/75" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <rect class="wave-bar" style="transform-box: fill-box; transform-origin: center;" x="4" y="13" width="2.5" height="6" rx="1.25" fill="currentColor" opacity="0.65"></rect>
                  <rect class="wave-bar" style="transform-box: fill-box; transform-origin: center;" x="9" y="9" width="2.5" height="14" rx="1.25" fill="currentColor" opacity="0.8"></rect>
                  <rect class="wave-bar" style="transform-box: fill-box; transform-origin: center;" x="14.5" y="5" width="3" height="22" rx="1.5" fill="currentColor"></rect>
                  <rect class="wave-bar" style="transform-box: fill-box; transform-origin: center;" x="20.5" y="9" width="2.5" height="14" rx="1.25" fill="currentColor" opacity="0.8"></rect>
                  <rect class="wave-bar" style="transform-box: fill-box; transform-origin: center;" x="25.5" y="13" width="2.5" height="6" rx="1.25" fill="currentColor" opacity="0.65"></rect>
                </svg>
              </div>
              <div class="flex-1 min-w-0 flex flex-col">
                <span id="music-title" class="font-title text-title-md text-light-on-surface truncate">未选择音频</span>
                <span id="music-meta" class="font-body text-body-sm text-light-on-surface-variant tabular-nums">已上传音频</span>
              </div>
              <button id="change-music-btn" type="button" class="shrink-0 h-7 px-2.5 rounded-full bg-light-surface-container hover:bg-light-surface-container-high font-label text-label-sm text-light-on-surface-variant transition-colors">更换</button>
              <button id="music-play-btn" type="button" aria-label="播放或暂停背景音乐" class="shrink-0 h-8 px-3 rounded-full bg-light-secondary/15 hover:bg-light-secondary/25 text-light-on-surface flex items-center gap-1 font-label text-label-sm transition-colors duration-state-change active:scale-95">
                <svg id="music-play-icon" class="w-3.5 h-3.5 text-light-secondary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5.5V18.5L18.5 12L8 5.5Z"></path>
                </svg>
                <span>试听</span>
              </button>
            </div>
            <!-- 迷雾蓝播放进度条 -->
            <div class="flex items-center gap-2">
              <div class="flex-1 h-1.5 rounded-full bg-light-secondary/15 overflow-hidden">
                <div id="music-progress-bar" class="h-full w-0 bg-light-secondary/55 rounded-full transition-all duration-150"></div>
              </div>
              <span id="music-time-label" class="font-mono text-body-sm text-light-on-surface-variant tabular-nums shrink-0">00:00 / 00:00</span>
            </div>
