          { title: '《浮空岛夏日手札 · 治愈日常》', author: '林屿', tag: '· #治愈日常', votes: 31200 }
        ],
        '长文飙升榜': [
          { title: '《雨夜旧怀表：审讯室反转》', author: '沈清晏', tag: '#悬疑推理', votes: 89310 },
          { title: '《浮空岛夏日手札 · 治愈日常》', author: '林屿', tag: '· #治愈日常', votes: 72450 },
          { title: '《京华深处》顾沉舟支线', author: '零度写作', tag: '· #现代都市', votes: 61800 },
          { title: '《星际休眠舱：第7号觉醒者》', author: '南风知意', tag: '· #星际科幻', votes: 48920 }
        ],
        '高能剧本榜': [
          { title: '《星际休眠舱：第7号觉醒者》', author: '南风知意', tag: '#4人推理本', votes: 112600 },
          { title: '《京华深处 · 雨夜审讯室》', author: '零度写作', tag: '· #6人阵营本', votes: 98400 },
          { title: '《雨夜旧怀表：审讯室反转》', author: '沈清晏', tag: '· #微恐还原本', votes: 76120 },
          { title: '《浮空岛秋日祭 · 双阵营演武》', author: '林屿', tag: '· #16人大型局', votes: 54300 }
        ],
        '人气创作者': [
          { title: '零度写作 · 现代都市 / 权谋长文', author: '代表作《京华深处》', tag: '#红V创作者', votes: 156800 },
          { title: '南风知意 · 科幻硬核 / 剧本局房主', author: '代表作《星际休眠舱》', tag: '· #蓝V创作者', votes: 118400 },
          { title: '沈清晏 · 悬疑反转 / AI演绎调教', author: '代表作《雨夜旧怀表》', tag: '· #紫V创作者', votes: 87900 },
