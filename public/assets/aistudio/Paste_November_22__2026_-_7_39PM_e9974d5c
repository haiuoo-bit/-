      <p data-design-text-token="body-sm" class="text-light-on-surface-variant">当前为交互原型演示，协议内容仅作展示。</p>
    </div>
    <button id="modal-policy-agree" type="button" class="w-full h-11 rounded-full bg-light-primary text-light-on-primary flex items-center justify-center">
      <span data-design-text-token="label-lg" class="font-label text-label-lg">已阅读并同意</span>
    </button>
  </dialog>

  <!-- ==================== 5. 页面交互逻辑脚本 ==================== -->
  <script>
    (function () {
      // ---------- DOM 元素引用 ----------
      const form = document.getElementById('pwd-login-form');
      const phoneInput = document.getElementById('phone-input');
      const clearPhoneBtn = document.getElementById('clear-phone-btn');
      const passwordInput = document.getElementById('password-input');
      const phoneError = document.getElementById('phone-error');
      const passwordError = document.getElementById('password-error');
      const agreeCheckbox = document.getElementById('agree-checkbox');
      const agreeRow = document.getElementById('agree-row');
      const togglePwdBtn = document.getElementById('toggle-pwd-btn');
      const togglePwdIcon = document.getElementById('toggle-pwd-icon');
      const submitBtn = document.getElementById('submit-btn');
      const submitSpinner = document.getElementById('submit-spinner');
      const submitLabel = document.getElementById('submit-label');

      const modalAgreement = document.getElementById('modal-agreement');
      const modalSuccess = document.getElementById('modal-success');
      const modalPolicy = document.getElementById('modal-policy');
      const modalPolicyTitle = document.getElementById('modal-policy-title');

      // ---------- 协议状态跨页同步 ----------
      function syncAgreementStorage(checked) {
        try {
          sessionStorage.setItem('rsdy_agreed', checked ? '1' : '0');
        } catch (e) {}
      }

      try {
        if (sessionStorage.getItem('rsdy_agreed') === '1') {
          agreeCheckbox.checked = true;
        }
      } catch (e) {}

      agreeCheckbox.addEventListener('change', function () {
        syncAgreementStorage(agreeCheckbox.checked);
        agreeRow.classList.remove('bg-error/10');
      });

      // ---------- 输入框过滤、清空与密码可见性切换 ----------
      phoneInput.addEventListener('input', function () {
        phoneInput.value = phoneInput.value.replace(/\D/g, '');
        clearPhoneBtn.classList.toggle('hidden', phoneInput.value.length === 0);
        phoneError.classList.add('hidden');
      });

      clearPhoneBtn.addEventListener('click', function () {
        phoneInput.value = '';
        clearPhoneBtn.classList.add('hidden');
        phoneInput.focus();
      });

      passwordInput.addEventListener('input', function () {
        passwordError.classList.add('hidden');
      });

      // 切换密码明文 / 密文显示
      togglePwdBtn.addEventListener('click', function () {
        const isPwd = passwordInput.type === 'password';
        passwordInput.type = isPwd ? 'text' : 'password';
        togglePwdIcon.textContent = isPwd ? 'visibility' : 'visibility_off';
      });

      // ---------- 表单校验函数 ----------
      function validatePhone() {
        const valid = /^1\d{10}$/.test(phoneInput.value.trim());
        phoneError.classList.toggle('hidden', valid);
        return valid;
      }

      function validatePassword() {
        const valid = passwordInput.value.length >= 6;
        passwordError.classList.toggle('hidden', valid);
        return valid;
      }

      // ---------- 执行登录提交加载与成功弹窗 ----------
      function triggerLogin() {
        submitBtn.disabled = true;
        submitSpinner.classList.remove('hidden');
        submitLabel.textContent = '正在登录...';
        setTimeout(function () {
          submitBtn.disabled = false;
          submitSpinner.classList.add('hidden');
          submitLabel.textContent = '立即登录';
          modalSuccess.showModal();
        }, 420);
      }

      // 表单提交：校验手机号 + 密码长度 + 协议勾选
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const pOk = validatePhone();
        const pwdOk = validatePassword();
        if (!pOk || !pwdOk) return;
        if (!agreeCheckbox.checked) {
          agreeRow.classList.add('bg-error/10');
          modalAgreement.showModal();
          return;
        }
        triggerLogin();
      });

      // ---------- 弹窗按钮事件绑定 ----------
      document.getElementById('modal-agreement-cancel').addEventListener('click', function () {
        modalAgreement.close();
      });
      document.getElementById('modal-agreement-confirm').addEventListener('click', function () {
        agreeCheckbox.checked = true;
        syncAgreementStorage(true);
        agreeRow.classList.remove('bg-error/10');
        modalAgreement.close();
        triggerLogin();
      });
      document.getElementById('modal-success-close').addEventListener('click', function () {
        modalSuccess.close();
      });

      document.querySelectorAll('.policy-link').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          modalPolicyTitle.textContent = btn.getAttribute('data-policy') || '协议详情';
          modalPolicy.showModal();
        });
      });
      document.getElementById('modal-policy-close').addEventListener('click', function () {
        modalPolicy.close();
      });
      document.getElementById('modal-policy-agree').addEventListener('click', function () {
        agreeCheckbox.checked = true;
        syncAgreementStorage(true);
        agreeRow.classList.remove('bg-error/10');
        modalPolicy.close();
      });
    })();
  </script>


</body></html>

