              <button type="button" data-amount="500" class="bounty-preset-btn h-7 px-2.5 rounded-full bg-light-primary text-light-on-primary border border-light-primary font-mono text-body-sm">￥50</button>
              <button type="button" data-amount="1000" class="bounty-preset-btn h-7 px-2.5 rounded-full bg-light-surface border border-light-outline-variant font-mono text-body-sm text-light-on-surface-variant hover:text-light-on-surface">￥100</button>
              <button type="button" data-amount="2000" class="bounty-preset-btn h-7 px-2.5 rounded-full bg-light-surface border border-light-outline-variant font-mono text-body-sm text-light-on-surface-variant hover:text-light-on-surface">￥200</button>
