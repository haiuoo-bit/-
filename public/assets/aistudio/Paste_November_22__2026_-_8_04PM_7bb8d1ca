      var progressTrigger = document.getElementById('progress-trigger');

      var ringProgress = document.getElementById('ring-progress');
      var ringIcon = document.getElementById('ring-icon');
      var statusText = document.getElementById('download-status-text');
      var percentText = document.getElementById('download-percent');
      var bar = document.getElementById('download-bar');

      var toast = document.getElementById('toast');
      var toastText = document.getElementById('toast-text');

      var CIRCUMFERENCE = 69.12; // 环形进度条周长（2 * π * 11）
      var timer = null;
      var toastTimer = null;

      // 页面进入即自动弹出版本更新模态框
      if (modalUpdate && typeof modalUpdate.showModal === 'function') {
        modalUpdate.showModal();
      }

      // ---------- 2. 全局轻提示 Toast 控制 ----------
