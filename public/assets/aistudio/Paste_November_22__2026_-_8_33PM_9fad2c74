          '<div class="flex items-start justify-between gap-2">' +
          '  <div class="flex items-center gap-1.5 flex-wrap">' +
          '    <span data-design-text-token="label-sm" class="px-2 py-0.5 rounded-full bg-light-surface-container text-light-secondary font-label text-label-sm">' + (catLabels[cat] || '集市好物') + '</span>' +
          '    <span data-design-text-token="label-sm" class="px-2 py-0.5 rounded-full bg-light-surface-container-low text-light-on-surface-variant font-mono text-label-sm">MD / TXT</span>' +
          '  </div>' +
          '  <span data-design-text-token="label-sm" class="font-body text-body-sm text-light-on-surface-variant tabular-nums shrink-0">刚刚上架</span>' +
          '</div>' +
          '<h2 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface text-balance"></h2>' +
          '<p data-design-text-token="body-sm" class="font-body text-body-sm text-light-on-surface-variant text-pretty"></p>' +
          '<div class="flex items-center justify-between gap-2 pt-2 border-t border-light-outline-variant/60">' +
          '  <div class="flex items-center gap-2 min-w-0">' +
          '    <img src="https://lh3.googleusercontent.com/aida/ALJJyrDEQtOit7dUyYZrE3Ttq8IJyuHHvf3PZtk3guFGLRtyN1j0MeXZCes-xb49Vqh7bq23vTPI7Dr12-ZIBxFrTU4rZF_cd9kaK86j-u6jOtg8l7Y2Cw_-MAe00GlQgEIOK5bR4EHxZGOWFicDXD5xyt1_nLOu9r3w7SSlSTEnmVnU81nXpRt6370RTjjyEeGhHJvKrueDLt3uIfel7CAzdjQE5Q32ARrahVYfJu7-pGieGXy8ME6uPPTs" alt="我" class="w-6 h-6 rounded-full object-cover shrink-0">' +
          '    <span data-design-text-token="body-sm" class="font-body text-body-sm text-light-on-surface-variant truncate">我 · 岛遇创作者</span>' +
          '  </div>' +
          '  <div class="flex items-center gap-2.5 shrink-0">' +
          '    <span data-design-text-token="title-md" class="font-mono text-title-md font-bold text-light-on-surface tabular-nums">' + price + ' 元</span>' +
          '    <button type="button" class="buy-btn h-8 px-3.5 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm hover:opacity-90 transition-opacity duration-state-change">购买</button>' +
          '  </div>' +
