  <script data-stitch-original-script="2d6c7ff30a1212bd===../../images/avatar_lingdu.jpg|||2d6c7ff30a1212bd===../../images/avatar_lingdu.jpg|||2d6c7ff30a1212bd===../../images/avatar_lingdu.jpg">
    (function () {
      // ---------- 1. 轻提示反馈工具 ----------
      const toast = document.getElementById('community-toast');
      let toastTimer = null;
      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.add('hidden'), 1800);
      }

      // ---------- 2. 社区搜索过滤、清空按钮与回车跳转全站搜索 ----------
      const searchForm = document.getElementById('community-search-form');
      const searchInput = document.getElementById('community-search-input');
      const clearSearchBtn = document.getElementById('community-clear-btn');
      let currentTopic = '推荐';

      function applyFilters() {
        const raw = (searchInput.value || '').trim();
        const q = raw.toLowerCase();
        if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', !raw);
        const cards = document.querySelectorAll('.post-card');
        let visible = 0;
        cards.forEach((card) => {
          const topic = card.dataset.topic || '';
          const text = (card.dataset.search || '') + ' ' + card.textContent;
          const matchTopic = currentTopic === '推荐' || topic === currentTopic;
          const matchQuery = !q || text.toLowerCase().includes(q);
          if (matchTopic && matchQuery) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });
        document.getElementById('community-empty').classList.toggle('hidden', visible > 0);
      }

      searchInput.addEventListener('input', applyFilters);
      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          searchInput.value = '';
          applyFilters();
          searchInput.focus();
        });
      }
      if (searchForm) {
        searchForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = (searchInput.value || '').trim();
          const url = '../51-global-search/GlobalSearch.html?scope=community' + (q ? '&q=' + encodeURIComponent(q) : '');
          window.location.href = url;
        });
      }

      // ---------- 3. 话题分类胶囊筛选 ----------
      const topicPills = document.querySelectorAll('.topic-pill');
      topicPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          currentTopic = pill.dataset.topic;
          topicPills.forEach((p) => {
            const active = p === pill;
            p.classList.toggle('bg-light-primary', active);
            p.classList.toggle('text-light-on-primary', active);
            p.classList.toggle('bg-light-surface-container', !active);
            p.classList.toggle('text-light-on-surface-variant', !active);
          });
          applyFilters();
        });
      });

      // ---------- 4. 帖子卡片互动绑定（关注、点赞、转发、收藏、评论） ----------
      function bindPostCard(card) {
        const followBtn = card.querySelector('.follow-btn');
        if (followBtn) {
          followBtn.addEventListener('click', () => {
            const followed = followBtn.textContent === '已关注';
            followBtn.textContent = followed ? '关注' : '已关注';
            followBtn.classList.toggle('text-light-on-surface-variant', !followed);
            followBtn.classList.toggle('text-light-on-surface', followed);
            showToast(followed ? '已取消关注' : '已关注该作者');
          });
        }

        const likeBtn = card.querySelector('.like-btn');
        if (likeBtn) {
          likeBtn.addEventListener('click', () => {
            const liked = likeBtn.getAttribute('aria-pressed') === 'true';
            const countEl = likeBtn.querySelector('.count');
            const val = parseInt(countEl.textContent, 10) || 0;
            likeBtn.setAttribute('aria-pressed', String(!liked));
            countEl.textContent = String(liked ? val - 1 : val + 1);
            likeBtn.classList.toggle('text-error', !liked);
            likeBtn.classList.toggle('text-light-on-surface-variant', liked);
            const outline = likeBtn.querySelector('.icon-outline');
            const filled = likeBtn.querySelector('.icon-filled');
            if (outline && filled) {
              outline.classList.toggle('hidden', !liked);
              filled.classList.toggle('hidden', liked);
            }
          });
        }

        const repostBtn = card.querySelector('.repost-btn');
        if (repostBtn) {
          repostBtn.addEventListener('click', () => {
            window.__activeShareRepostBtn = repostBtn;
            document.getElementById('share-sheet').classList.remove('hidden');
          });
        }

        const bookmarkBtn = card.querySelector('.bookmark-btn');
        if (bookmarkBtn) {
          bookmarkBtn.addEventListener('click', () => {
            const saved = bookmarkBtn.getAttribute('aria-pressed') === 'true';
            const countEl = bookmarkBtn.querySelector('.count');
            bookmarkBtn.setAttribute('aria-pressed', String(!saved));
            bookmarkBtn.classList.toggle('text-light-secondary', !saved);
            bookmarkBtn.classList.toggle('text-light-on-surface-variant', saved);
            if (countEl) {
              const val = parseInt(countEl.textContent, 10) || 0;
              countEl.textContent = String(saved ? val - 1 : val + 1);
            }
            const outline = bookmarkBtn.querySelector('.icon-outline');
            const filled = bookmarkBtn.querySelector('.icon-filled');
            if (outline && filled) {
              outline.classList.toggle('hidden', !saved);
              filled.classList.toggle('hidden', saved);
            }
            showToast(saved ? '已取消收藏' : '已收藏帖子');
          });
        }

        const commentBtn = card.querySelector('.comment-btn');
        if (commentBtn) {
          commentBtn.addEventListener('click', () => {
            activeCommentBtn = commentBtn;
            const cntEl = commentBtn.querySelector('.comment-count');
            const totalEl = document.getElementById('drawer-comment-total');
            if (totalEl && cntEl) totalEl.textContent = cntEl.textContent;
            if (typeof resetReplyTarget === 'function') resetReplyTarget();
            openCommentDrawer();
          });
        }
      }

      document.querySelectorAll('.post-card').forEach(bindPostCard);

      // ---------- 5. 帖子内交互投票（先选选项再点击确认投票） ----------
      document.querySelectorAll('.poll-box').forEach((box) => {
        const options = box.querySelectorAll('.poll-option');
        const totalEl = box.querySelector('.poll-total');
        const confirmBtn = box.querySelector('.poll-confirm-btn');
        let selectedOpt = null;
        let voted = false;
        options.forEach((opt) => {
          opt.addEventListener('click', () => {
            if (voted) return;
