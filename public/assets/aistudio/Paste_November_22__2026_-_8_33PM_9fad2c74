        <!-- [章节 5] 注意事项 -->
        <section class="flex flex-col gap-1.5">
          <h3 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">注意事项</h3>
          <ul class="flex flex-col gap-1.5 font-body text-body-sm text-light-on-surface-variant list-disc pl-5">
            <li>请于活动开始前 15 分钟下载设定文档并熟悉个人人物小传。</li>
            <li>严禁剧透或场外贴脸，通关后需在截止时间前上传结算截图方可领取奖励。</li>
          </ul>
        </section>
      </div>
    </div>

    <!-- ==================== 3. 底部吸底报名与领奖操作栏 ==================== -->
    <footer class="shrink-0 z-20 bg-light-surface border-t border-light-outline-variant px-gutter-lg pt-gutter-sm pb-gutter-lg flex items-center justify-between gap-gutter-md">
      <div class="flex flex-col">
        <span id="footer-stage-text" data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface">报名中 · 剩 1 席（返航派）</span>
        <span id="footer-time-text" data-design-text-token="body-sm" class="font-body text-body-sm text-light-on-surface-variant tabular-nums">11-24 20:00 报名截止</span>
      </div>

      <button id="primary-cta-btn" type="button" class="shrink-0 h-11 px-gutter-xl rounded-full bg-light-primary text-light-on-primary font-label text-label-lg transition-transform duration-state-change active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-light-secondary">
        立即报名
      </button>
    </footer>

    <!-- [反馈] 全局轻提示 Toast -->
    <div id="script-toast" role="status" aria-live="polite" class="pointer-events-none hidden absolute top-20 left-1/2 -translate-x-1/2 z-50 px-gutter-lg py-gutter-sm rounded-full bg-light-primary text-light-on-primary font-label text-label-sm shadow-lg whitespace-nowrap"></div>
  </main>

  <script>
    (function () {
      // ---------- 1. 轻提示 ----------
      const toast = document.getElementById('script-toast');
      let toastTimer = null;

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.classList.add('hidden');
        }, 2000);
      }

      // ---------- 2. 阵营选择与报名/领奖状态机 ----------
      let enrolled = false;
      let proofUploaded = false;
      let rewardClaimed = false;
      let selectedFaction = '返航派';
      let selectedRemain = '1';

      const factionCards = Array.from(document.querySelectorAll('.faction-card'));
      const factionHintText = document.getElementById('faction-hint-text');
      const primaryCta = document.getElementById('primary-cta-btn');
      const footerStageText = document.getElementById('footer-stage-text');
      const footerTimeText = document.getElementById('footer-time-text');
      const taskHubCard = document.getElementById('task-hub-card');
      const taskLockedTip = document.getElementById('task-locked-tip');
      const taskActionsRow = document.getElementById('task-actions-row');
      const unlockBadge = document.getElementById('unlock-badge');
      const downloadDocBtn = document.getElementById('download-doc-btn');
      const uploadProofBtn = document.getElementById('upload-proof-btn');
      const uploadProofLabel = document.getElementById('upload-proof-label');
      const proofStatusText = document.getElementById('proof-status-text');
      const heroStatusPill = document.getElementById('hero-status-pill');

      // 可折叠章节（故事背景与世界观 / 玩法规则与奖励）
      document.querySelectorAll('.collapse-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const targetId = btn.getAttribute('data-collapse-target');
          const panel = targetId ? document.getElementById(targetId) : null;
          const chevron = btn.querySelector('.collapse-chevron');
          if (!panel) return;
          const willCollapse = !panel.classList.contains('hidden');
          panel.classList.toggle('hidden', willCollapse);
          btn.setAttribute('aria-expanded', willCollapse ? 'false' : 'true');
          if (chevron) chevron.classList.toggle('rotate-180', !willCollapse);
        });
      });

      factionCards.forEach(function (card) {
        card.addEventListener('click', function () {
          if (enrolled) {
            showToast('已锁定阵营：' + selectedFaction);
            return;
          }
          selectedFaction = card.getAttribute('data-faction') || '返航派';
          selectedRemain = card.getAttribute('data-remain') || '1';
          factionCards.forEach(function (c) {
            const active = c === card;
            c.setAttribute('aria-pressed', active ? 'true' : 'false');
            c.classList.toggle('border-2', active);
            c.classList.toggle('border-light-primary', active);
            c.classList.toggle('bg-light-primary/5', active);
            c.classList.toggle('border', !active);
            c.classList.toggle('border-light-outline-variant', !active);
            c.classList.toggle('bg-light-surface', !active);
            c.classList.toggle('hover:border-light-secondary', !active);
            const badge = c.querySelector('.faction-badge');
            if (badge) {
              badge.textContent = active ? '已选中' : '可报名';
              badge.className = active
                ? 'faction-badge px-2.5 py-0.5 rounded-full bg-light-primary text-light-on-primary font-label text-label-sm'
                : 'faction-badge px-2.5 py-0.5 rounded-full bg-success/10 text-success font-label text-label-sm';
            }
          });
          syncState();
        });
      });

      // 根据报名、上传截图、领奖状态同步底部栏与任务资料解锁状态
      function syncState() {
        if (!enrolled) {
          primaryCta.textContent = '立即报名';
          footerStageText.textContent = '报名中 · 剩 ' + selectedRemain + ' 席（' + selectedFaction + '）';
          footerTimeText.textContent = '11-24 20:00 报名截止';
          unlockBadge.textContent = '报名后解锁';
          unlockBadge.className = 'px-2 py-0.5 rounded-full bg-light-surface-container font-label text-label-sm text-light-on-surface-variant';
          if (taskLockedTip) taskLockedTip.classList.remove('hidden');
          if (taskActionsRow) taskActionsRow.classList.add('hidden');
          return;
        }

        heroStatusPill.textContent = '已报名';
        if (factionHintText) {
          factionHintText.textContent = '已锁定阵营：' + selectedFaction;
          factionHintText.className = 'font-label text-label-sm text-light-on-surface-variant';
        }
        unlockBadge.textContent = '已解锁 · 可下载/上传';
        unlockBadge.className = 'px-2 py-0.5 rounded-full bg-success text-light-on-primary font-label text-label-sm';
        if (taskLockedTip) taskLockedTip.classList.add('hidden');
        if (taskActionsRow) taskActionsRow.classList.remove('hidden');
        if (taskHubCard) {
          taskHubCard.classList.remove('border-light-outline-variant', 'bg-light-surface-container-low');
          taskHubCard.classList.add('border-success/40', 'bg-success/5');
        }

        if (!proofUploaded) {
          primaryCta.textContent = '去下载/传图';
          footerStageText.textContent = '已锁定阵营：' + selectedFaction;
          footerTimeText.textContent = '11-24 20:30 准时开局';
        } else if (!rewardClaimed) {
          primaryCta.textContent = '领取奖励';
          footerStageText.textContent = '已上传通关截图';
          footerTimeText.textContent = '可领取星海徽章 +￥200';
        } else {
          primaryCta.textContent = '已领取';
          primaryCta.classList.add('opacity-70');
          footerStageText.textContent = '活动奖励已到账';
          footerTimeText.textContent = '感谢参与本场剧本局';
        }
      }

      function scrollToTaskHub() {
        if (taskHubCard) {
          taskHubCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      primaryCta.addEventListener('click', function () {
        if (!enrolled) {
          enrolled = true;
          syncState();
          showToast('报名成功！已解锁设定文档下载');
          scrollToTaskHub();
        } else if (!proofUploaded) {
          scrollToTaskHub();
          showToast('可点击「下载设定文档」或「上传通关截图」');
        } else if (!rewardClaimed) {
          rewardClaimed = true;
          syncState();
          showToast('奖励「星海徽章 +￥200」已领取！');
        }
      });

      // ---------- 3. 设定文档下载、通关截图上传与时间轴展开 ----------
      downloadDocBtn.addEventListener('click', function () {
        if (!enrolled) {
          showToast('请先点击下方「立即报名」解锁设定文档');
          return;
        }
        showToast('正在保存《星际休眠舱_完整设定文档.pdf》');
      });

      uploadProofBtn.addEventListener('click', function () {
        if (!enrolled) {
          showToast('请先报名参与活动后再上传通关截图');
          return;
        }
        proofUploaded = true;
        uploadProofLabel.textContent = '已上传通关截图';
        proofStatusText.classList.remove('hidden');
        syncState();
        showToast('通关截图上传成功，可点击下方「领取奖励」');
      });

      document.getElementById('share-script-btn').addEventListener('click', function () {
        showToast('剧本局邀请链接已复制');
      });

      const timeTabBtn = document.getElementById('time-tab-btn');
      const timeSchedulePanel = document.getElementById('time-schedule-panel');
      const timeTabChevron = document.getElementById('time-tab-chevron');
      if (timeTabBtn && timeSchedulePanel) {
        timeTabBtn.addEventListener('click', function () {
          const isHidden = timeSchedulePanel.classList.toggle('hidden');
          timeTabBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
          if (timeTabChevron) {
            timeTabChevron.classList.toggle('rotate-180', !isHidden);
          }
        });
      }
    })();
  </script>


</body></html>

