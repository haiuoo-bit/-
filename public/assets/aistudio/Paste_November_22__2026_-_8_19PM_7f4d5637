      // ---------- 1. DOM 引用与 Toast 提示 ----------
      const chips = document.querySelectorAll('.script-filter-chip');
      const modal = document.getElementById('script-permission-modal');
      const toast = document.getElementById('script-toast');
      let toastTimer = null;

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 2200);
      }

      // ---------- 2. 剧本局状态筛选胶囊切换 ----------
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          const status = chip.getAttribute('data-status');
          chips.forEach(function (c) {
            const active = c === chip;
            c.classList.toggle('bg-light-primary', active);
            c.classList.toggle('text-light-on-primary', active);
            c.classList.toggle('bg-light-surface-container', !active);
            c.classList.toggle('text-light-on-surface-variant', !active);
          });
          document.querySelectorAll('.script-card').forEach(function (card) {
            const match = status === 'all' || card.getAttribute('data-status') === status;
            card.classList.toggle('hidden', !match);
          });
        });
      });

      // ---------- 3. 发起组局权限弹窗开关与申请提交 ----------
      document.getElementById('open-create-script-btn').addEventListener('click', function () {
        modal.classList.remove('hidden');
